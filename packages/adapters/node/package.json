{
  "name": "@emulates/adapter-node",
  "version": "0.0.0-development",
  "private": true,
  "description": "Serve any Emulates FetchAPI over node:http.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crvouga/emulates.git",
    "directory": "packages/adapters/node"
  },
  "homepage": "https://github.com/crvouga/emulates/tree/main/packages/adapters/node#readme",
  "keywords": [
    "emulates",
    "adapter",
    "node"
  ],
  "emulates": {
    "runtime": "node",
    "layer": "adapter"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "test": "bun test",
    "portability": "bun ../../../scripts/portability.ts",
    "pack:check": "bun ../../../scripts/pack-check.ts"
  },
  "dependencies": {
    "@emulates/core": "workspace:*",
    "@emulates/service": "workspace:*"
  },
  "devDependencies": {
    "@emulates/testing": "workspace:*",
    "@types/node": "22.20.1",
    "@types/pg": "8.23.1",
    "fast-check": "4.9.0",
    "ioredis": "5.11.1",
    "pg": "8.23.0"
  }
}
