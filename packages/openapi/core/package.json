{
  "name": "@emulators/openapi",
  "version": "0.0.0-development",
  "private": true,
  "description": "OpenAPI 3.1 loading, $ref resolution, operation discovery, schema traversal and instance validation for Emulators. No fast-check, no Hono, no providers.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crvouga/emulators.git",
    "directory": "packages/openapi/core"
  },
  "homepage": "https://github.com/crvouga/emulators/tree/main/packages/openapi/core#readme",
  "keywords": [
    "emulators",
    "openapi",
    "json-schema"
  ],
  "emulators": {
    "runtime": "portable",
    "layer": "openapi"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "test": "bun test",
    "portability": "bun ../../../scripts/portability.ts",
    "pack:check": "bun ../../../scripts/pack-check.ts"
  },
  "devDependencies": {
    "@emulators/testing": "workspace:*",
    "fast-check": "4.9.0"
  }
}
