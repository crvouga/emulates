{
  "name": "@emulators/openapi-metadata",
  "version": "0.0.0-development",
  "private": true,
  "description": "The x-emulators-* OpenAPI extensions: types, readers, semantic validation and schema-guided value annotation (identities, volatile fields).",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crvouga/emulators.git",
    "directory": "packages/openapi/metadata"
  },
  "homepage": "https://github.com/crvouga/emulators/tree/main/packages/openapi/metadata#readme",
  "keywords": [
    "emulators",
    "openapi",
    "extensions"
  ],
  "emulators": {
    "runtime": "portable",
    "layer": "openapi-metadata"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "test": "bun test",
    "portability": "bun ../../../scripts/portability.ts",
    "pack:check": "bun ../../../scripts/pack-check.ts"
  },
  "dependencies": {
    "@emulators/openapi": "workspace:*"
  },
  "devDependencies": {
    "@emulators/testing": "workspace:*",
    "fast-check": "4.9.0"
  }
}
