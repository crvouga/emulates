{
  "name": "@emulators/openapi-codegen",
  "version": "0.1.0",
  "description": "Turns a provider's openapi.yaml into a portable generated TypeScript module plus a SUPPORT.md coverage matrix; validates Emulators metadata.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "private": true,
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crvouga/emulators.git",
    "directory": "packages/openapi/codegen"
  },
  "homepage": "https://github.com/crvouga/emulators/tree/main/packages/openapi/codegen#readme",
  "keywords": [
    "emulators",
    "openapi",
    "codegen"
  ],
  "emulators": {
    "runtime": "node",
    "layer": "openapi"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "test": "bun test"
  },
  "dependencies": {
    "@emulators/openapi": "workspace:*",
    "@emulators/openapi-metadata": "workspace:*",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "fast-check": "4.9.0",
    "@emulators/testing": "workspace:*"
  },
  "bin": {
    "emulators-codegen": "./dist/cli.js"
  }
}
