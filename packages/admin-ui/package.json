{
  "name": "@emulators/admin-ui",
  "version": "0.0.0-development",
  "private": true,
  "type": "module",
  "description": "The self-contained React and Ant Design admin client shared by every emulator.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "emulators": {
    "runtime": "portable",
    "layer": "ui"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && bun scripts/build.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "test": "bun test"
  },
  "dependencies": {
    "@ant-design/cssinjs": "2.1.2",
    "@ant-design/icons": "6.3.4",
    "antd": "6.6.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2"
  }
}
