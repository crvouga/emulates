{
  "name": "@emulates/http-codec",
  "version": "0.0.0-development",
  "private": true,
  "description": "Content-type codecs shared by the emulator servers and differential runner: JSON and bracket-notation form encoding.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crvouga/emulators.git",
    "directory": "packages/http/codec"
  },
  "homepage": "https://github.com/crvouga/emulators/tree/main/packages/http/codec#readme",
  "keywords": [
    "emulates",
    "form-urlencoded",
    "codec"
  ],
  "emulates": {
    "runtime": "portable",
    "layer": "http-codec"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "test": "bun test",
    "portability": "bun ../../../scripts/portability.ts",
    "pack:check": "bun ../../../scripts/pack-check.ts"
  },
  "devDependencies": {
    "@emulates/testing": "workspace:*",
    "fast-check": "4.9.0"
  }
}
