{
  "name": "@emulators/sqlite-client",
  "version": "0.0.0-development",
  "private": true,
  "description": "Owned sync SqliteClient port for Emulators services. Defaults to @emulators/sqlite; accepts any duck-typed SQLite client.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crvouga/emulators.git",
    "directory": "packages/sqlite"
  },
  "homepage": "https://github.com/crvouga/emulators/tree/main/packages/sqlite#readme",
  "keywords": [
    "emulators",
    "sqlite"
  ],
  "emulators": {
    "runtime": "portable",
    "layer": "sqlite"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "test": "bun test",
    "portability": "bun ../../scripts/portability.ts",
    "pack:check": "bun ../../scripts/pack-check.ts"
  },
  "dependencies": {
    "@emulators/sqlite": "workspace:*"
  },
  "devDependencies": {
    "@emulators/testing": "workspace:*",
    "fast-check": "4.9.0"
  }
}
