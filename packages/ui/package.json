{
  "name": "@emulates/ui",
  "version": "0.0.0-development",
  "private": true,
  "description": "The cross-browser CSS reset every Emulates HTML surface starts from.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./reset.css": "./src/reset.css"
  },
  "emulates": {
    "runtime": "portable",
    "layer": "ui"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "test": "bun test"
  }
}
