{
  "name": "@emulates/canonicalize",
  "version": "0.0.0-development",
  "private": true,
  "description": "Strict, provider-neutral canonicalisation of HTTP exchanges for differential comparison: symbolic id replacement, declared volatile fields, parity headers, structural diff.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crvouga/emulators.git",
    "directory": "packages/parity/canonicalize"
  },
  "homepage": "https://github.com/crvouga/emulators/tree/main/packages/parity/canonicalize#readme",
  "keywords": [
    "emulates",
    "parity",
    "canonicalize"
  ],
  "emulates": {
    "runtime": "portable",
    "layer": "parity"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "test": "bun test",
    "portability": "bun ../../../scripts/portability.ts",
    "pack:check": "bun ../../../scripts/pack-check.ts"
  },
  "dependencies": {
    "@emulates/openapi": "workspace:*",
    "@emulates/openapi-metadata": "workspace:*",
    "@emulates/model": "workspace:*",
    "@emulates/http-codec": "workspace:*"
  },
  "devDependencies": {
    "fast-check": "4.9.0",
    "@emulates/testing": "workspace:*"
  }
}
