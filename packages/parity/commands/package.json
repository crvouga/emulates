{
  "name": "@emulators/commands",
  "version": "0.0.0-development",
  "private": true,
  "description": "Stateful fast-check command generation for OpenAPI-driven random API walks: operation eligibility, symbolic resource references, shrink-friendly commands.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crvouga/emulators.git",
    "directory": "packages/parity/commands"
  },
  "homepage": "https://github.com/crvouga/emulators/tree/main/packages/parity/commands#readme",
  "keywords": [
    "emulators",
    "parity",
    "commands"
  ],
  "emulators": {
    "runtime": "portable",
    "layer": "parity"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "test": "bun test",
    "portability": "bun ../../../scripts/portability.ts",
    "pack:check": "bun ../../../scripts/pack-check.ts"
  },
  "dependencies": {
    "@emulators/openapi": "workspace:*",
    "@emulators/openapi-metadata": "workspace:*",
    "@emulators/openapi-arbitrary": "workspace:*",
    "@emulators/model": "workspace:*",
    "fast-check": "4.9.0",
    "@emulators/http-codec": "workspace:*"
  },
  "devDependencies": {
    "@emulators/testing": "workspace:*"
  }
}
