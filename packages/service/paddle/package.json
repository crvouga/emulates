{
  "name": "@emulators/paddle",
  "version": "0.0.0-development",
  "description": "Stateful emulator of the Paddle Billing API (customers, addresses, businesses, products, prices, transactions with computed totals, subscriptions with pause/resume/cancel and renewals, events) with Paddle-Signature webhooks and admin routes that simulate checkout, renewals and failed payments (Emulators service contract).",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "DISCOVERY.md",
    "SUPPORT.md",
    "openapi.yaml"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "bin": {
    "emulators-paddle": "./dist/cli.js"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crvouga/emulators.git",
    "directory": "packages/service/paddle"
  },
  "homepage": "https://github.com/crvouga/emulators/tree/main/packages/service/paddle#readme",
  "keywords": [
    "emulators",
    "service",
    "paddle",
    "billing",
    "subscriptions",
    "payments",
    "webhooks",
    "emulator"
  ],
  "emulators": {
    "runtime": "portable",
    "entries": {
      "server": "node",
      "cli": "node"
    },
    "layer": "service",
    "category": "payments",
    "displayName": "Paddle",
    "vendor": {
      "website": "https://www.paddle.com/billing",
      "docs": "https://developer.paddle.com/api-reference/overview"
    },
    "parity": "Billing, subscriptions, and webhooks",
    "parityTier": "cold",
    "playground": {
      "operation": "CreateCustomer",
      "headers": {
        "authorization": "Bearer pdl_sdbx_apikey_emulators"
      }
    },
    "discovery": {
      "guide": "DISCOVERY.md",
      "behavior": "README.md",
      "capabilities": "SUPPORT.md",
      "contract": "openapi.yaml",
      "types": "dist/index.d.ts",
      "oracle": {
        "kind": "Live vendor API or sandbox",
        "command": "bun run parity:service -- paddle",
        "note": "Run from an Emulators checkout; credentials come only from .env.local or GitHub Actions secrets. Missing credentials exit 2."
      },
      "introspection": [
        "GET /__admin/health",
        "GET /__admin",
        "GET /__admin/state",
        "GET /__admin/requests",
        "GET /__admin/metrics",
        "GET /__admin/faults/presets",
        "GET /__admin/ui"
      ],
      "reporting": "https://github.com/crvouga/emulators/blob/main/docs/REPORTING_ISSUES.md"
    }
  },
  "scripts": {
    "generate": "bun ../../openapi/codegen/dist/cli.js",
    "generate:check": "bun ../../openapi/codegen/dist/cli.js --check",
    "openapi:check": "bun ../../openapi/codegen/dist/cli.js --validate",
    "build": "bun ../../../scripts/bundle-service.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "test": "bun test",
    "parity": "bun scripts/parity.ts",
    "portability": "bun ../../../scripts/portability.ts",
    "pack:check": "bun ../../../scripts/pack-check.ts"
  },
  "dependencies": {
    "@emulators/sqlite": "workspace:*",
    "hono": "4.11.9"
  },
  "devDependencies": {
    "@emulators/adapter-node": "workspace:*",
    "@emulators/core": "workspace:*",
    "@emulators/credentials": "workspace:*",
    "@emulators/http-codec": "workspace:*",
    "@emulators/openapi": "workspace:*",
    "@emulators/openapi-codegen": "workspace:*",
    "@emulators/openapi-metadata": "workspace:*",
    "@emulators/parity": "workspace:*",
    "@emulators/service": "workspace:*",
    "@emulators/sqlite": "workspace:*",
    "@emulators/sqlite-client": "workspace:*",
    "@emulators/testing": "workspace:*",
    "@paddle/paddle-node-sdk": "3.10.0",
    "fast-check": "4.9.0"
  }
}
