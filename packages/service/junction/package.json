{
  "name": "@emulators/junction",
  "version": "0.0.0-development",
  "description": "Stateful emulator of the Junction (Vital) user API driven by its OpenAPI contract and verified by differential property tests against the Junction sandbox.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "DISCOVERY.md",
    "SUPPORT.md",
    "openapi.yaml"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./corpus": {
      "types": "./dist/corpus.d.ts",
      "default": "./dist/corpus.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "bin": {
    "emulators-junction": "./dist/cli.js"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crvouga/emulators.git",
    "directory": "packages/service/junction"
  },
  "homepage": "https://github.com/crvouga/emulators/tree/main/packages/service/junction#readme",
  "keywords": [
    "emulators",
    "service",
    "junction",
    "vital"
  ],
  "emulators": {
    "runtime": "portable",
    "entries": {
      "server": "node",
      "cli": "node"
    },
    "layer": "service",
    "category": "health",
    "displayName": "Junction",
    "vendor": {
      "website": "https://www.junction.com",
      "docs": "https://docs.junction.com"
    },
    "parity": "Users, orders, and lab results",
    "parityTier": "cold",
    "parityInputs": [
      "PARITY_FAILURE_SEED_REGISTRY.json"
    ],
    "discovery": {
      "guide": "DISCOVERY.md",
      "behavior": "README.md",
      "capabilities": "SUPPORT.md",
      "contract": "openapi.yaml",
      "types": "dist/index.d.ts",
      "oracle": {
        "kind": "Live vendor API or sandbox",
        "command": "bun run parity:service -- junction",
        "note": "Run from an Emulators checkout; credentials come only from .env.local or GitHub Actions secrets. Missing credentials exit 2."
      },
      "introspection": [
        "GET /__admin/health",
        "GET /__admin",
        "GET /__admin/state",
        "GET /__admin/requests",
        "GET /__admin/metrics",
        "GET /__admin/faults/presets",
        "GET /__admin/ui"
      ],
      "reporting": "https://github.com/crvouga/emulators/blob/main/docs/REPORTING_ISSUES.md"
    }
  },
  "scripts": {
    "generate": "bun ../../openapi/codegen/dist/cli.js",
    "generate:check": "bun ../../openapi/codegen/dist/cli.js --check",
    "openapi:check": "bun ../../openapi/codegen/dist/cli.js --validate",
    "build": "bun ../../../scripts/bundle-service.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "test": "bun test",
    "parity": "bun scripts/parity.ts",
    "mock:server": "bun scripts/server.ts",
    "mock:serve": "bun scripts/server.ts",
    "corpus:record": "bun scripts/record-corpus.ts",
    "client-parity": "bun scripts/client-parity.ts",
    "client-parity:live": "JUNCTION_LIVE_PARITY=1 bun scripts/client-parity-live.ts",
    "webhook:dev": "wrangler dev --config webhook-receiver/wrangler.jsonc",
    "webhook:deploy": "wrangler deploy --config webhook-receiver/wrangler.jsonc",
    "webhook:register": "bun scripts/register-webhook.ts",
    "portability": "bun ../../../scripts/portability.ts",
    "pack:check": "bun ../../../scripts/pack-check.ts",
    "verify": "bun src/cli.ts verify"
  },
  "dependencies": {
    "@emulators/sqlite": "workspace:*",
    "hono": "4.11.9"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260929.1",
    "@emulators/openapi-codegen": "workspace:*",
    "@emulators/adapter-node": "workspace:*",
    "@emulators/openapi-metadata": "workspace:*",
    "@emulators/credentials": "workspace:*",
    "@emulators/testing": "workspace:*",
    "@emulators/sqlite": "workspace:*",
    "@tryvital/vital-node": "3.1.511",
    "fast-check": "4.9.0",
    "wrangler": "^4.143.0",
    "@emulators/core": "workspace:*",
    "@emulators/sqlite-client": "workspace:*",
    "@emulators/openapi": "workspace:*",
    "@emulators/service": "workspace:*",
    "@emulators/http-codec": "workspace:*",
    "@emulators/commands": "workspace:*",
    "@emulators/parity": "workspace:*"
  }
}
