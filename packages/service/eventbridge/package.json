{
  "name": "@emulates/eventbridge",
  "version": "0.0.0-development",
  "description": "Seeded AWS EventBridge rule and ECS target discovery with pagination.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "DISCOVERY.md",
    "SUPPORT.md",
    "openapi.yaml"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "bin": {
    "emulates-eventbridge": "./dist/cli.js"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crvouga/emulators.git",
    "directory": "packages/service/eventbridge"
  },
  "homepage": "https://github.com/crvouga/emulators/tree/main/packages/service/eventbridge#readme",
  "keywords": [
    "emulates",
    "aws",
    "eventbridge",
    "emulator"
  ],
  "emulates": {
    "runtime": "portable",
    "entries": {
      "server": "node",
      "cli": "node"
    },
    "layer": "service",
    "category": "communication",
    "displayName": "AWS EventBridge",
    "status": "wip",
    "vendor": {
      "website": "https://aws.amazon.com/eventbridge/",
      "docs": "https://docs.aws.amazon.com/eventbridge/latest/APIReference/Welcome.html"
    },
    "parity": "Seeded rule and target discovery with pagination",
    "parityTier": "cold",
    "playground": {
      "operation": "EventBridgeRpc"
    },
    "discovery": {
      "guide": "DISCOVERY.md",
      "behavior": "README.md",
      "capabilities": "SUPPORT.md",
      "contract": "openapi.yaml",
      "types": "dist/index.d.ts",
      "oracle": {
        "kind": "Live vendor API or sandbox",
        "command": "bun run parity:service -- eventbridge",
        "note": "Run from an Emulates checkout; credentials come only from .env.local or GitHub Actions secrets. Missing credentials exit 2."
      },
      "introspection": [
        "GET /__admin/health",
        "GET /__admin",
        "GET /__admin/state",
        "GET /__admin/requests",
        "GET /__admin/metrics",
        "GET /__admin/faults/presets",
        "GET /__admin/ui"
      ],
      "reporting": "https://github.com/crvouga/emulators/blob/main/docs/REPORTING_ISSUES.md"
    },
    "aws": {
      "localstackService": "events",
      "operations": [
        "CreateEventBus",
        "DescribeEventBus",
        "ListEventBuses",
        "DeleteEventBus",
        "PutRule",
        "DescribeRule",
        "ListRules",
        "DeleteRule",
        "EnableRule",
        "DisableRule",
        "PutTargets",
        "ListTargetsByRule",
        "RemoveTargets",
        "PutEvents",
        "TagResource",
        "UntagResource",
        "ListTagsForResource"
      ]
    }
  },
  "scripts": {
    "generate": "bun ../../openapi/codegen/dist/cli.js",
    "generate:check": "bun ../../openapi/codegen/dist/cli.js --check",
    "openapi:check": "bun ../../openapi/codegen/dist/cli.js --validate",
    "build": "bun ../../../scripts/bundle-service.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "test": "bun test",
    "parity": "bun scripts/parity.ts",
    "portability": "bun ../../../scripts/portability.ts",
    "pack:check": "bun ../../../scripts/pack-check.ts",
    "parity:localstack": "bun scripts/localstack-parity.ts"
  },
  "dependencies": {
    "@emulates/sqlite": "workspace:*"
  },
  "devDependencies": {
    "@aws-sdk/client-eventbridge": "3.1132.0",
    "@emulates/credentials": "workspace:*",
    "@emulates/adapter-node": "workspace:*",
    "@emulates/core": "workspace:*",
    "@emulates/openapi": "workspace:*",
    "@emulates/openapi-codegen": "workspace:*",
    "@emulates/openapi-metadata": "workspace:*",
    "@emulates/parity": "workspace:*",
    "@emulates/service": "workspace:*",
    "@emulates/sqlite-client": "workspace:*",
    "@emulates/testing": "workspace:*",
    "fast-check": "4.9.0"
  }
}
