{
  "name": "@emulates/vercel-blob",
  "version": "0.0.0-development",
  "description": "Stateful Vercel Blob emulator: binary uploads, public downloads, metadata, cursor listing and multipart commits.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "DISCOVERY.md",
    "SUPPORT.md",
    "openapi.yaml"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "bin": {
    "emulates-vercel-blob": "./dist/cli.js"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crvouga/emulates.git",
    "directory": "packages/service/vercel-blob"
  },
  "homepage": "https://github.com/crvouga/emulates/tree/main/packages/service/vercel-blob#readme",
  "keywords": [
    "emulates",
    "service",
    "vercel",
    "blob",
    "storage"
  ],
  "emulates": {
    "runtime": "portable",
    "entries": {
      "server": "node",
      "cli": "node"
    },
    "layer": "service",
    "category": "storage",
    "displayName": "Vercel Blob",
    "status": "wip",
    "vendor": {
      "website": "https://vercel.com",
      "docs": "https://vercel.com/docs/vercel-blob/using-blob-sdk",
      "description": "Vercel Blob provides object storage for uploads and public downloads.",
      "icon": "vercel"
    },
    "parity": "Uploads, public bytes, metadata, list, copy, delete and multipart",
    "parityTier": "cold",
    "playground": {
      "headers": {
        "Authorization": "Bearer vercel_blob_rw_fixture_fixture"
      },
      "operation": "ReadBlobStore"
    },
    "discovery": {
      "guide": "DISCOVERY.md",
      "behavior": "README.md",
      "capabilities": "SUPPORT.md",
      "contract": "openapi.yaml",
      "types": "dist/index.d.ts",
      "oracle": {
        "kind": "Live vendor API or sandbox",
        "command": "bun run parity:service -- vercel-blob",
        "note": "Run from an Emulates checkout; credentials come only from .env.local or GitHub Actions secrets. Missing credentials exit 2."
      },
      "introspection": [
        "GET /__admin/health",
        "GET /__admin",
        "GET /__admin/state",
        "GET /__admin/requests",
        "GET /__admin/metrics",
        "GET /__admin/faults/presets",
        "GET /__admin/ui"
      ],
      "reporting": "https://github.com/crvouga/emulates/blob/main/docs/REPORTING_ISSUES.md"
    }
  },
  "scripts": {
    "generate": "bun ../../openapi/codegen/dist/cli.js",
    "generate:check": "bun ../../openapi/codegen/dist/cli.js --check",
    "openapi:check": "bun ../../openapi/codegen/dist/cli.js --validate",
    "build": "bun ../../../scripts/bundle-service.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "test": "bun test",
    "parity": "bun scripts/parity.ts",
    "portability": "bun ../../../scripts/portability.ts",
    "pack:check": "bun ../../../scripts/pack-check.ts"
  },
  "dependencies": {
    "@emulates/sqlite": "workspace:*",
    "hono": "4.11.9",
    "@noble/hashes": "2.4.0"
  },
  "devDependencies": {
    "fast-check": "4.9.0",
    "@emulates/testing": "workspace:*",
    "@emulates/sqlite": "workspace:*",
    "@emulates/parity": "workspace:*",
    "@emulates/credentials": "workspace:*",
    "@emulates/openapi-codegen": "workspace:*",
    "@emulates/openapi-metadata": "workspace:*",
    "@emulates/core": "workspace:*",
    "@emulates/sqlite-client": "workspace:*",
    "@emulates/openapi": "workspace:*",
    "@emulates/service": "workspace:*",
    "@emulates/http-codec": "workspace:*",
    "@emulates/adapter-node": "workspace:*",
    "@vercel/blob": "2.8.0"
  }
}
