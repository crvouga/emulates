{
  "name": "@emulates/workos",
  "version": "0.0.0-development",
  "description": "Stateful WorkOS AuthKit emulator with signed sessions, rotating refresh tokens and user pagination.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "SUPPORT.md",
    "openapi.yaml",
    "DISCOVERY.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "bin": {
    "emulates-workos": "./dist/cli.js"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crvouga/emulators.git",
    "directory": "packages/service/workos"
  },
  "homepage": "https://github.com/crvouga/emulators/tree/main/packages/service/workos#readme",
  "keywords": [
    "emulates",
    "workos",
    "authkit",
    "emulator"
  ],
  "emulates": {
    "runtime": "portable",
    "entries": {
      "server": "node",
      "cli": "node"
    },
    "layer": "service",
    "category": "identity",
    "displayName": "WorkOS",
    "status": "wip",
    "vendor": {
      "website": "https://workos.com",
      "docs": "https://workos.com/docs/reference/authkit/authentication"
    },
    "parity": "AuthKit codes, signed sessions, refresh and user pagination",
    "parityTier": "cold",
    "playground": {
      "headers": {
        "authorization": "Bearer mock_workos_key"
      },
      "operation": "ListUsers"
    },
    "discovery": {
      "guide": "DISCOVERY.md",
      "behavior": "README.md",
      "capabilities": "SUPPORT.md",
      "contract": "openapi.yaml",
      "types": "dist/index.d.ts",
      "oracle": {
        "kind": "Live vendor API or sandbox",
        "command": "bun run parity:service -- workos",
        "note": "Run from an Emulates checkout; credentials come only from .env.local or GitHub Actions secrets. Missing credentials exit 2."
      },
      "introspection": [
        "GET /__admin/health",
        "GET /__admin",
        "GET /__admin/state",
        "GET /__admin/requests",
        "GET /__admin/metrics",
        "GET /__admin/faults/presets",
        "GET /__admin/ui"
      ],
      "reporting": "https://github.com/crvouga/emulators/blob/main/docs/REPORTING_ISSUES.md"
    }
  },
  "scripts": {
    "generate": "bun ../../openapi/codegen/dist/cli.js",
    "generate:check": "bun ../../openapi/codegen/dist/cli.js --check",
    "openapi:check": "bun ../../openapi/codegen/dist/cli.js --validate",
    "build": "bun ../../../scripts/bundle-service.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "test": "bun test",
    "parity": "bun scripts/parity.ts",
    "portability": "bun ../../../scripts/portability.ts",
    "pack:check": "bun ../../../scripts/pack-check.ts"
  },
  "dependencies": {
    "@emulates/sqlite": "workspace:*",
    "hono": "4.11.9"
  },
  "devDependencies": {
    "@emulates/adapter-node": "workspace:*",
    "@emulates/core": "workspace:*",
    "@emulates/credentials": "workspace:*",
    "@emulates/openapi": "workspace:*",
    "@emulates/openapi-codegen": "workspace:*",
    "@emulates/parity": "workspace:*",
    "@emulates/service": "workspace:*",
    "@emulates/sqlite-client": "workspace:*",
    "@emulates/testing": "workspace:*",
    "@workos-inc/node": "9.3.1",
    "@workos-inc/authkit-nextjs": "4.1.0",
    "next": "15.5.9",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "fast-check": "4.9.0",
    "jose": "6.1.3"
  }
}
