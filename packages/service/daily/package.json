{
  "name": "@emulators/daily",
  "version": "0.0.0-development",
  "description": "Stateful emulator of the Daily.co REST API: rooms, presence, eject, meeting tokens (minted and self-signed HS256, verified and decodable), and transcription/recording webhooks with transcripts written to S3.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "DISCOVERY.md",
    "SUPPORT.md",
    "openapi.yaml"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "bin": {
    "emulators-daily": "./dist/cli.js"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crvouga/emulators.git",
    "directory": "packages/service/daily"
  },
  "homepage": "https://github.com/crvouga/emulators/tree/main/packages/service/daily#readme",
  "keywords": [
    "emulators",
    "service",
    "daily",
    "daily.co",
    "video",
    "webrtc",
    "meeting-tokens",
    "webhooks"
  ],
  "emulators": {
    "runtime": "portable",
    "entries": {
      "server": "node",
      "cli": "node"
    },
    "layer": "service",
    "category": "communication",
    "displayName": "Daily",
    "vendor": {
      "website": "https://www.daily.co",
      "docs": "https://docs.daily.co/reference/rest-api",
      "description": "Daily provides real-time video and audio APIs for embedding calls, plus the open-source Pipecat voice-agent framework."
    },
    "parity": "Rooms, tokens, and webhooks",
    "parityTier": "cold",
    "discovery": {
      "guide": "DISCOVERY.md",
      "behavior": "README.md",
      "capabilities": "SUPPORT.md",
      "contract": "openapi.yaml",
      "types": "dist/index.d.ts",
      "oracle": {
        "kind": "Live vendor API or sandbox",
        "command": "bun run parity:service -- daily",
        "note": "Run from an Emulators checkout; credentials come only from .env.local or GitHub Actions secrets. Missing credentials exit 2."
      },
      "introspection": [
        "GET /__admin/health",
        "GET /__admin",
        "GET /__admin/state",
        "GET /__admin/requests",
        "GET /__admin/metrics",
        "GET /__admin/faults/presets",
        "GET /__admin/ui"
      ],
      "reporting": "https://github.com/crvouga/emulators/blob/main/docs/REPORTING_ISSUES.md"
    }
  },
  "scripts": {
    "generate": "bun ../../openapi/codegen/dist/cli.js",
    "generate:check": "bun ../../openapi/codegen/dist/cli.js --check",
    "openapi:check": "bun ../../openapi/codegen/dist/cli.js --validate",
    "build": "bun ../../../scripts/bundle-service.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "test": "bun test",
    "parity": "bun scripts/parity.ts",
    "portability": "bun ../../../scripts/portability.ts",
    "pack:check": "bun ../../../scripts/pack-check.ts"
  },
  "dependencies": {
    "@emulators/sqlite": "workspace:*",
    "hono": "4.11.9"
  },
  "devDependencies": {
    "fast-check": "4.9.0",
    "@emulators/testing": "workspace:*",
    "@emulators/sqlite": "workspace:*",
    "@emulators/parity": "workspace:*",
    "@emulators/credentials": "workspace:*",
    "@emulators/openapi-codegen": "workspace:*",
    "@emulators/openapi-metadata": "workspace:*",
    "@emulators/core": "workspace:*",
    "@emulators/sqlite-client": "workspace:*",
    "@emulators/openapi": "workspace:*",
    "@emulators/service": "workspace:*",
    "@emulators/http-codec": "workspace:*",
    "@emulators/adapter-node": "workspace:*"
  }
}
