{
  "name": "@emulators/aws-secrets",
  "version": "0.0.0-development",
  "description": "Stateful AWS Secrets Manager and SSM Parameter Store emulator with versions, stages, rotation, and redacted controls.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "DISCOVERY.md",
    "SUPPORT.md",
    "openapi.yaml"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "bin": {
    "emulators-aws-secrets": "./dist/cli.js"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crvouga/emulators.git",
    "directory": "packages/service/aws-secrets"
  },
  "homepage": "https://github.com/crvouga/emulators/tree/main/packages/service/aws-secrets#readme",
  "keywords": [
    "emulators",
    "aws",
    "secrets-manager",
    "ssm",
    "parameter-store",
    "emulator"
  ],
  "emulators": {
    "runtime": "portable",
    "entries": {
      "server": "node",
      "cli": "node"
    },
    "layer": "service",
    "category": "identity",
    "displayName": "AWS Secrets Manager & SSM",
    "vendor": {
      "website": "https://aws.amazon.com/secrets-manager/",
      "docs": "https://docs.aws.amazon.com/secretsmanager/latest/apireference/"
    },
    "parity": "Secrets Manager and Parameter Store",
    "parityTier": "cold",
    "discovery": {
      "guide": "DISCOVERY.md",
      "behavior": "README.md",
      "capabilities": "SUPPORT.md",
      "contract": "openapi.yaml",
      "types": "dist/index.d.ts",
      "oracle": {
        "kind": "Live vendor API or sandbox",
        "command": "bun run parity:service -- aws-secrets",
        "note": "Run from an Emulators checkout; credentials come only from .env.local or GitHub Actions secrets. Missing credentials exit 2."
      },
      "introspection": [
        "GET /__admin/health",
        "GET /__admin",
        "GET /__admin/state",
        "GET /__admin/requests",
        "GET /__admin/metrics",
        "GET /__admin/faults/presets",
        "GET /__admin/ui"
      ],
      "reporting": "https://github.com/crvouga/emulators/blob/main/docs/REPORTING_ISSUES.md"
    }
  },
  "scripts": {
    "generate": "bun ../../openapi/codegen/dist/cli.js",
    "generate:check": "bun ../../openapi/codegen/dist/cli.js --check",
    "openapi:check": "bun ../../openapi/codegen/dist/cli.js --validate",
    "build": "bun ../../../scripts/bundle-service.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "test": "bun test",
    "parity": "bun scripts/parity.ts",
    "portability": "bun ../../../scripts/portability.ts",
    "pack:check": "bun ../../../scripts/pack-check.ts"
  },
  "dependencies": {
    "@emulators/sqlite": "workspace:*"
  },
  "devDependencies": {
    "@aws-sdk/client-secrets-manager": "3.1132.0",
    "@aws-sdk/client-ssm": "3.1132.0",
    "@emulators/adapter-node": "workspace:*",
    "@emulators/core": "workspace:*",
    "@emulators/openapi": "workspace:*",
    "@emulators/openapi-codegen": "workspace:*",
    "@emulators/openapi-metadata": "workspace:*",
    "@emulators/parity": "workspace:*",
    "@emulators/service": "workspace:*",
    "@emulators/sqlite-client": "workspace:*",
    "@emulators/testing": "workspace:*",
    "fast-check": "4.9.0"
  }
}
