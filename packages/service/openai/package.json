{
  "name": "@emulates/openai",
  "version": "0.0.0-development",
  "description": "Local scripted OpenAI emulator: chat/tool loops, SSE, embeddings, models, files and staged uploads without billed inference.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "DISCOVERY.md",
    "SUPPORT.md",
    "openapi.yaml"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "bin": {
    "emulates-openai": "./dist/cli.js"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crvouga/emulates.git",
    "directory": "packages/service/openai"
  },
  "homepage": "https://github.com/crvouga/emulates/tree/main/packages/service/openai#readme",
  "keywords": [
    "emulates",
    "service",
    "openai",
    "ai",
    "testing"
  ],
  "emulates": {
    "runtime": "portable",
    "entries": {
      "server": "node",
      "cli": "node"
    },
    "layer": "service",
    "category": "ai",
    "displayName": "OpenAI",
    "status": "wip",
    "vendor": {
      "website": "https://openai.com",
      "docs": "https://developers.openai.com/api/reference/resources/chat/subresources/completions/methods/create",
      "description": "OpenAI provides chat, embeddings and agent APIs; this emulator uses local scripts only.",
      "icon": "openai"
    },
    "parity": "Scripted chat/tool calls, SSE, embeddings, models, files and uploads",
    "parityTier": "cold",
    "playground": {
      "headers": {
        "authorization": "Bearer fixture-openai-token"
      },
      "operation": "ListModels"
    },
    "discovery": {
      "guide": "DISCOVERY.md",
      "behavior": "README.md",
      "capabilities": "SUPPORT.md",
      "contract": "openapi.yaml",
      "types": "dist/index.d.ts",
      "oracle": {
        "kind": "Official documentation and local SDK oracle",
        "command": "bun run parity:service -- openai",
        "note": "Live billed inference is disabled by repository policy. The package parity runner exits 2; tests verify official SDKs locally."
      },
      "introspection": [
        "GET /__admin/health",
        "GET /__admin",
        "GET /__admin/state",
        "GET /__admin/requests",
        "GET /__admin/metrics",
        "GET /__admin/faults/presets",
        "GET /__admin/ui"
      ],
      "reporting": "https://github.com/crvouga/emulates/blob/main/docs/REPORTING_ISSUES.md"
    }
  },
  "scripts": {
    "generate": "bun ../../openapi/codegen/dist/cli.js",
    "generate:check": "bun ../../openapi/codegen/dist/cli.js --check",
    "openapi:check": "bun ../../openapi/codegen/dist/cli.js --validate",
    "build": "bun ../../../scripts/bundle-service.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "test": "bun test",
    "parity": "bun scripts/parity.ts",
    "portability": "bun ../../../scripts/portability.ts",
    "pack:check": "bun ../../../scripts/pack-check.ts"
  },
  "dependencies": {
    "@emulates/sqlite": "workspace:*",
    "hono": "4.11.9",
    "@noble/hashes": "2.4.0",
    "@noble/ciphers": "2.4.0"
  },
  "devDependencies": {
    "fast-check": "4.9.0",
    "@emulates/testing": "workspace:*",
    "@emulates/sqlite": "workspace:*",
    "@emulates/parity": "workspace:*",
    "@emulates/credentials": "workspace:*",
    "@emulates/openapi-codegen": "workspace:*",
    "@emulates/openapi-metadata": "workspace:*",
    "@emulates/core": "workspace:*",
    "@emulates/sqlite-client": "workspace:*",
    "@emulates/openapi": "workspace:*",
    "@emulates/service": "workspace:*",
    "@emulates/http-codec": "workspace:*",
    "@emulates/adapter-node": "workspace:*",
    "@ai-sdk/openai": "4.0.83",
    "ai": "7.0.127",
    "openai": "7.27.0"
  }
}
