{
  "name": "@emulators/posthog",
  "version": "0.0.0-development",
  "description": "Stateful emulator of PostHog: /flags v2 and legacy /decide evaluation with per-test flag, variant and payload control, remote config, gzip/base64 capture (/batch/, /e/, /i/v0/e/), recordings intake, and the feature-flag management and HogQL API slice.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "DISCOVERY.md",
    "SUPPORT.md",
    "openapi.yaml"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "bin": {
    "emulators-posthog": "./dist/cli.js"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crvouga/emulators.git",
    "directory": "packages/service/posthog"
  },
  "homepage": "https://github.com/crvouga/emulators/tree/main/packages/service/posthog#readme",
  "keywords": [
    "emulators",
    "service",
    "posthog",
    "feature-flags",
    "analytics",
    "capture"
  ],
  "emulators": {
    "runtime": "portable",
    "entries": {
      "server": "node",
      "cli": "node"
    },
    "layer": "service",
    "category": "observability",
    "displayName": "PostHog",
    "vendor": {
      "website": "https://posthog.com",
      "docs": "https://posthog.com/docs/api",
      "description": "PostHog is an open-source product analytics platform with feature flags, session replay, experiments and surveys."
    },
    "parity": "Flags, capture, and HogQL",
    "parityTier": "cold",
    "discovery": {
      "guide": "DISCOVERY.md",
      "behavior": "README.md",
      "capabilities": "SUPPORT.md",
      "contract": "openapi.yaml",
      "types": "dist/index.d.ts",
      "oracle": {
        "kind": "Live vendor API or sandbox",
        "command": "bun run parity:service -- posthog",
        "note": "Run from an Emulators checkout; credentials come only from .env.local or GitHub Actions secrets. Missing credentials exit 2."
      },
      "introspection": [
        "GET /__admin/health",
        "GET /__admin",
        "GET /__admin/state",
        "GET /__admin/requests",
        "GET /__admin/metrics",
        "GET /__admin/faults/presets",
        "GET /__admin/ui"
      ],
      "reporting": "https://github.com/crvouga/emulators/blob/main/docs/REPORTING_ISSUES.md"
    }
  },
  "scripts": {
    "generate": "bun ../../openapi/codegen/dist/cli.js",
    "generate:check": "bun ../../openapi/codegen/dist/cli.js --check",
    "openapi:check": "bun ../../openapi/codegen/dist/cli.js --validate",
    "build": "bun ../../../scripts/bundle-service.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "test": "bun test",
    "parity": "bun scripts/parity.ts",
    "portability": "bun ../../../scripts/portability.ts",
    "pack:check": "bun ../../../scripts/pack-check.ts"
  },
  "dependencies": {
    "@emulators/sqlite": "workspace:*",
    "hono": "4.11.9"
  },
  "devDependencies": {
    "fast-check": "4.9.0",
    "@emulators/testing": "workspace:*",
    "@emulators/sqlite": "workspace:*",
    "@emulators/parity": "workspace:*",
    "@emulators/credentials": "workspace:*",
    "@emulators/openapi-codegen": "workspace:*",
    "@emulators/openapi-metadata": "workspace:*",
    "@emulators/core": "workspace:*",
    "@emulators/sqlite-client": "workspace:*",
    "@emulators/openapi": "workspace:*",
    "@emulators/service": "workspace:*",
    "@emulators/http-codec": "workspace:*",
    "@emulators/adapter-node": "workspace:*",
    "posthog-node": "5.52.2",
    "@posthog/core": "1.54.0",
    "posthog-js": "1.433.2"
  }
}
