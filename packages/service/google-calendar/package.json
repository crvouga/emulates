{
  "name": "@emulates/google-calendar",
  "version": "0.0.0-development",
  "description": "Stateful emulator of the Google Calendar v3 API and Google OAuth our EMR calls: events list/insert/update/delete/watch, channels.stop, calendarList/calendars, token exchange/refresh/revoke and userinfo, with signed-by-header push notifications.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "DISCOVERY.md",
    "SUPPORT.md",
    "openapi.yaml"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "bin": {
    "emulates-google-calendar": "./dist/cli.js"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crvouga/emulators.git",
    "directory": "packages/service/google-calendar"
  },
  "homepage": "https://github.com/crvouga/emulators/tree/main/packages/service/google-calendar#readme",
  "keywords": [
    "emulates",
    "service",
    "google-calendar",
    "googleapis",
    "oauth2",
    "calendar"
  ],
  "emulates": {
    "runtime": "portable",
    "entries": {
      "server": "node",
      "cli": "node"
    },
    "layer": "service",
    "category": "productivity",
    "displayName": "Google Calendar",
    "vendor": {
      "website": "https://workspace.google.com/products/calendar/",
      "docs": "https://developers.google.com/calendar/api/v3/reference"
    },
    "parity": "Events and OAuth",
    "parityTier": "cold",
    "discovery": {
      "guide": "DISCOVERY.md",
      "behavior": "README.md",
      "capabilities": "SUPPORT.md",
      "contract": "openapi.yaml",
      "types": "dist/index.d.ts",
      "oracle": {
        "kind": "Live vendor API or sandbox",
        "command": "bun run parity:service -- google-calendar",
        "note": "Run from an Emulates checkout; credentials come only from .env.local or GitHub Actions secrets. Missing credentials exit 2."
      },
      "introspection": [
        "GET /__admin/health",
        "GET /__admin",
        "GET /__admin/state",
        "GET /__admin/requests",
        "GET /__admin/metrics",
        "GET /__admin/faults/presets",
        "GET /__admin/ui"
      ],
      "reporting": "https://github.com/crvouga/emulators/blob/main/docs/REPORTING_ISSUES.md"
    }
  },
  "scripts": {
    "generate": "bun ../../openapi/codegen/dist/cli.js",
    "generate:check": "bun ../../openapi/codegen/dist/cli.js --check",
    "openapi:check": "bun ../../openapi/codegen/dist/cli.js --validate",
    "build": "bun ../../../scripts/bundle-service.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "test": "bun test",
    "parity": "bun scripts/parity.ts",
    "portability": "bun ../../../scripts/portability.ts",
    "pack:check": "bun ../../../scripts/pack-check.ts"
  },
  "dependencies": {
    "@emulates/sqlite": "workspace:*",
    "hono": "4.11.9"
  },
  "devDependencies": {
    "fast-check": "4.9.0",
    "@emulates/testing": "workspace:*",
    "@emulates/sqlite": "workspace:*",
    "@emulates/parity": "workspace:*",
    "@emulates/credentials": "workspace:*",
    "@emulates/openapi-codegen": "workspace:*",
    "@emulates/openapi-metadata": "workspace:*",
    "@emulates/core": "workspace:*",
    "@emulates/sqlite-client": "workspace:*",
    "@emulates/openapi": "workspace:*",
    "@emulates/service": "workspace:*",
    "@emulates/http-codec": "workspace:*",
    "@emulates/adapter-node": "workspace:*",
    "@googleapis/calendar": "9.8.0",
    "google-auth-library": "9.15.0"
  }
}
