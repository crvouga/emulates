{
  "name": "@emulates/aws-speech",
  "version": "0.0.0-development",
  "description": "Stateful emulator of AWS Polly (SynthesizeSpeech, StartSpeechSynthesisStream) and Transcribe (streaming over h2c, batch jobs), with exact event-stream framing and scripted transcripts.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "DISCOVERY.md",
    "SUPPORT.md",
    "openapi.yaml"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "bin": {
    "emulates-aws-speech": "./dist/cli.js"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crvouga/emulates.git",
    "directory": "packages/service/aws-speech"
  },
  "homepage": "https://github.com/crvouga/emulates/tree/main/packages/service/aws-speech#readme",
  "keywords": [
    "emulates",
    "service",
    "aws",
    "polly",
    "transcribe",
    "speech",
    "tts",
    "stt",
    "eventstream"
  ],
  "emulates": {
    "runtime": "portable",
    "entries": {
      "server": "node",
      "cli": "node"
    },
    "layer": "service",
    "category": "ai",
    "displayName": "AWS Polly & Transcribe",
    "vendor": {
      "website": "https://aws.amazon.com/polly/",
      "docs": "https://docs.aws.amazon.com/polly/latest/dg/API_Reference.html"
    },
    "parity": "Polly and Transcribe",
    "parityTier": "cold",
    "discovery": {
      "guide": "DISCOVERY.md",
      "behavior": "README.md",
      "capabilities": "SUPPORT.md",
      "contract": "openapi.yaml",
      "types": "dist/index.d.ts",
      "oracle": {
        "kind": "Live vendor API or sandbox",
        "command": "bun run parity:service -- aws-speech",
        "note": "Run from an Emulates checkout; credentials come only from .env.local or GitHub Actions secrets. Missing credentials exit 2."
      },
      "introspection": [
        "GET /__admin/health",
        "GET /__admin",
        "GET /__admin/state",
        "GET /__admin/requests",
        "GET /__admin/metrics",
        "GET /__admin/faults/presets",
        "GET /__admin/ui"
      ],
      "reporting": "https://github.com/crvouga/emulates/blob/main/docs/REPORTING_ISSUES.md"
    }
  },
  "scripts": {
    "generate": "bun ../../openapi/codegen/dist/cli.js",
    "generate:check": "bun ../../openapi/codegen/dist/cli.js --check",
    "openapi:check": "bun ../../openapi/codegen/dist/cli.js --validate",
    "build": "bun ../../../scripts/bundle-service.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "test": "bun test",
    "parity": "bun scripts/parity.ts",
    "portability": "bun ../../../scripts/portability.ts",
    "pack:check": "bun ../../../scripts/pack-check.ts"
  },
  "dependencies": {
    "@emulates/sqlite": "workspace:*",
    "hono": "4.11.9"
  },
  "devDependencies": {
    "@aws-sdk/client-polly": "3.1132.0",
    "@aws-sdk/client-transcribe": "3.1132.0",
    "@aws-sdk/client-transcribe-streaming": "3.1132.0",
    "@emulates/adapter-node": "workspace:*",
    "@emulates/core": "workspace:*",
    "@emulates/http-codec": "workspace:*",
    "@emulates/openapi": "workspace:*",
    "@emulates/openapi-codegen": "workspace:*",
    "@emulates/openapi-metadata": "workspace:*",
    "@emulates/credentials": "workspace:*",
    "@emulates/parity": "workspace:*",
    "@emulates/service": "workspace:*",
    "@emulates/sqlite": "workspace:*",
    "@emulates/sqlite-client": "workspace:*",
    "@emulates/testing": "workspace:*",
    "@smithy/eventstream-codec": "4.5.2",
    "fast-check": "4.9.0",
    "mpg123-decoder": "1.0.3"
  }
}
