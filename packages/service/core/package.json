{
  "name": "@emulates/service",
  "version": "0.0.0-development",
  "private": true,
  "description": "Generic service runtime: Fetch-native APIs, Hono dispatch keyed by OpenAPI operationId, SQLite-backed collections, request parsing and operation registries.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./admin": {
      "types": "./dist/engine-admin.d.ts",
      "default": "./dist/engine-admin.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crvouga/emulates.git",
    "directory": "packages/service/core"
  },
  "homepage": "https://github.com/crvouga/emulates/tree/main/packages/service/core#readme",
  "keywords": [
    "emulates",
    "service"
  ],
  "emulates": {
    "runtime": "portable",
    "layer": "service"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "test": "bun test",
    "portability": "bun ../../../scripts/portability.ts",
    "pack:check": "bun ../../../scripts/pack-check.ts"
  },
  "dependencies": {
    "@emulates/admin-ui": "workspace:*",
    "@emulates/core": "workspace:*",
    "@emulates/http-codec": "workspace:*",
    "@emulates/openapi": "workspace:*",
    "@emulates/openapi-metadata": "workspace:*",
    "@emulates/sqlite-client": "workspace:*",
    "@emulates/ui": "workspace:*",
    "fast-xml-parser": "5.11.2",
    "hono": "4.11.9"
  },
  "devDependencies": {
    "fast-check": "4.9.0",
    "@emulates/testing": "workspace:*",
    "@emulates/sqlite": "workspace:*"
  }
}
