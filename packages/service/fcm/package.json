{
  "name": "@emulates/fcm",
  "version": "0.0.0-development",
  "description": "Stateful emulator of the Firebase Cloud Messaging HTTP v1 send API used by firebase-admin: fixture projects and registration tokens, an outbox, and a device inbox.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "DISCOVERY.md",
    "SUPPORT.md",
    "openapi.yaml"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./admin": {
      "types": "./dist/admin.d.ts",
      "default": "./dist/admin.js"
    }
  },
  "bin": {
    "emulates-fcm": "./dist/cli.js"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crvouga/emulates.git",
    "directory": "packages/service/fcm"
  },
  "homepage": "https://github.com/crvouga/emulates/tree/main/packages/service/fcm#readme",
  "keywords": [
    "emulates",
    "service",
    "fcm",
    "firebase",
    "firebase-admin",
    "messaging"
  ],
  "emulates": {
    "runtime": "portable",
    "entries": {
      "server": "node",
      "cli": "node",
      "admin": "node"
    },
    "layer": "service",
    "category": "communication",
    "displayName": "Firebase Cloud Messaging",
    "status": "wip",
    "vendor": {
      "website": "https://firebase.google.com",
      "docs": "https://firebase.google.com/docs/reference/fcm/rest/v1/projects.messages/send",
      "icon": "firebase"
    },
    "parity": "FCM HTTP v1 send",
    "parityTier": "cold",
    "playground": {
      "operation": "SendMessage",
      "headers": {
        "authorization": "Bearer fixture-token"
      }
    },
    "discovery": {
      "guide": "DISCOVERY.md",
      "behavior": "README.md",
      "capabilities": "SUPPORT.md",
      "contract": "openapi.yaml",
      "types": "dist/index.d.ts",
      "oracle": {
        "kind": "Live vendor API or sandbox",
        "command": "bun run parity:service -- fcm",
        "note": "Run from an Emulates checkout; credentials come only from .env.local or GitHub Actions secrets. Missing credentials exit 2."
      },
      "introspection": [
        "GET /__admin/health",
        "GET /__admin",
        "GET /__admin/state",
        "GET /__admin/requests",
        "GET /__admin/metrics",
        "GET /__admin/faults/presets",
        "GET /__admin/ui"
      ],
      "reporting": "https://github.com/crvouga/emulates/blob/main/docs/REPORTING_ISSUES.md"
    }
  },
  "scripts": {
    "generate": "bun ../../openapi/codegen/dist/cli.js",
    "generate:check": "bun ../../openapi/codegen/dist/cli.js --check",
    "openapi:check": "bun ../../openapi/codegen/dist/cli.js --validate",
    "build": "bun ../../../scripts/bundle-service.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "test": "bun test",
    "parity": "bun scripts/parity.ts",
    "portability": "bun ../../../scripts/portability.ts",
    "pack:check": "bun ../../../scripts/pack-check.ts"
  },
  "dependencies": {
    "@emulates/sqlite": "workspace:*",
    "hono": "4.11.9"
  },
  "devDependencies": {
    "fast-check": "4.9.0",
    "firebase-admin": "13.5.0",
    "firebase-admin-12": "npm:firebase-admin@12.7.0",
    "@emulates/testing": "workspace:*",
    "@emulates/sqlite": "workspace:*",
    "@emulates/parity": "workspace:*",
    "@emulates/credentials": "workspace:*",
    "@emulates/openapi-codegen": "workspace:*",
    "@emulates/openapi-metadata": "workspace:*",
    "@emulates/core": "workspace:*",
    "@emulates/sqlite-client": "workspace:*",
    "@emulates/openapi": "workspace:*",
    "@emulates/service": "workspace:*",
    "@emulates/http-codec": "workspace:*",
    "@emulates/adapter-node": "workspace:*"
  }
}
