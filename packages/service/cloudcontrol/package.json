{
  "name": "@emulates/cloudcontrol",
  "version": "0.0.0-development",
  "description": "Work-in-progress Amazon Cloud Control API transport scaffold; vendor operations are not implemented.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "DISCOVERY.md",
    "SUPPORT.md",
    "openapi.yaml"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "bin": {
    "emulates-cloudcontrol": "./dist/cli.js"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crvouga/emulates.git",
    "directory": "packages/service/cloudcontrol"
  },
  "homepage": "https://github.com/crvouga/emulates/tree/main/packages/service/cloudcontrol#readme",
  "keywords": [
    "emulates",
    "aws",
    "cloudcontrol",
    "emulator"
  ],
  "emulates": {
    "runtime": "portable",
    "entries": {
      "server": "node",
      "cli": "node"
    },
    "layer": "service",
    "category": "storage",
    "displayName": "Amazon Cloud Control API",
    "vendor": {
      "website": "https://aws.amazon.com/",
      "docs": "https://docs.aws.amazon.com/",
      "name": "Amazon Web Services",
      "icon": false,
      "description": "Cloud Control API public AWS API.",
      "color": "#FF9900"
    },
    "parity": "Scaffold only; no vendor operations implemented or verified",
    "parityTier": "cold",
    "aws": {
      "localstackService": "cloudcontrol",
      "plannedOperations": [
        "CreateResource",
        "GetResource",
        "ListResources",
        "UpdateResource",
        "DeleteResource",
        "GetResourceRequestStatus",
        "ListResourceRequests",
        "CancelResourceRequest"
      ],
      "operations": []
    },
    "discovery": {
      "guide": "DISCOVERY.md",
      "behavior": "README.md",
      "capabilities": "SUPPORT.md",
      "contract": "openapi.yaml",
      "types": "dist/index.d.ts",
      "oracle": {
        "kind": "Live vendor API or sandbox",
        "command": "bun run parity:service -- cloudcontrol",
        "note": "Run from an Emulates checkout; credentials come only from .env.local or GitHub Actions secrets. Missing credentials exit 2."
      },
      "introspection": [
        "GET /__admin/health",
        "GET /__admin",
        "GET /__admin/state",
        "GET /__admin/requests",
        "GET /__admin/metrics",
        "GET /__admin/faults/presets",
        "GET /__admin/ui"
      ],
      "reporting": "https://github.com/crvouga/emulates/blob/main/docs/REPORTING_ISSUES.md"
    }
  },
  "scripts": {
    "generate": "bun ../../openapi/codegen/dist/cli.js",
    "generate:check": "bun ../../openapi/codegen/dist/cli.js --check",
    "openapi:check": "bun ../../openapi/codegen/dist/cli.js --validate",
    "build": "bun ../../../scripts/bundle-service.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "test": "bun test",
    "parity": "bun scripts/parity.ts",
    "portability": "bun ../../../scripts/portability.ts",
    "pack:check": "bun ../../../scripts/pack-check.ts"
  },
  "dependencies": {
    "@emulates/sqlite": "workspace:*"
  },
  "devDependencies": {
    "@emulates/adapter-node": "workspace:*",
    "@emulates/core": "workspace:*",
    "@emulates/openapi": "workspace:*",
    "@emulates/openapi-codegen": "workspace:*",
    "@emulates/openapi-metadata": "workspace:*",
    "@emulates/parity": "workspace:*",
    "@emulates/service": "workspace:*",
    "@emulates/sqlite-client": "workspace:*",
    "@emulates/testing": "workspace:*",
    "fast-check": "4.9.0"
  }
}
