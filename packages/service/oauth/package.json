{
  "name": "@emulates/oauth",
  "version": "0.0.0-development",
  "description": "Social-login emulator with Google, Apple, Microsoft, GitHub and generic OIDC profiles, private relay identities, reproducible edge cases, signed tokens and an accessible UI.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "DISCOVERY.md",
    "SUPPORT.md",
    "openapi.yaml"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "bin": {
    "emulates-oauth": "./dist/cli.js"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crvouga/emulates.git",
    "directory": "packages/service/oauth"
  },
  "homepage": "https://github.com/crvouga/emulates/tree/main/packages/service/oauth#readme",
  "keywords": [
    "emulates",
    "oauth",
    "openid-connect",
    "google",
    "apple",
    "social-login",
    "emulator",
    "microsoft",
    "github",
    "fault-injection"
  ],
  "emulates": {
    "runtime": "portable",
    "entries": {
      "server": "node",
      "cli": "node"
    },
    "layer": "service",
    "category": "identity",
    "displayName": "OAuth & Social Login",
    "vendor": {
      "website": "https://openid.net",
      "docs": "https://openid.net/specs/openid-connect-core-1_0.html",
      "name": "OpenID Foundation",
      "description": "The OpenID Foundation maintains OpenID Connect, the identity layer on OAuth 2.0 used by Google, Apple, Microsoft and other sign-in providers."
    },
    "parity": "OIDC and social login",
    "parityTier": "cold",
    "examples": [
      {
        "id": "google-login",
        "title": "Try a complete OAuth login",
        "description": "Choose popup or redirect, sign in through OAuth Emulator, and return to an example app. The client, Hono server, and provider all run in process.",
        "entry": "examples/google-login/index.ts",
        "sources": [
          "examples/google-login/app.ts",
          "examples/google-login/transport.ts",
          "examples/google-login/paste.ts",
          "examples/google-login/index.ts"
        ]
      }
    ],
    "discovery": {
      "guide": "DISCOVERY.md",
      "behavior": "README.md",
      "capabilities": "SUPPORT.md",
      "contract": "openapi.yaml",
      "types": "dist/index.d.ts",
      "oracle": {
        "kind": "Live vendor API or sandbox",
        "command": "bun run parity:service -- oauth",
        "note": "Run from an Emulates checkout; credentials come only from .env.local or GitHub Actions secrets. Missing credentials exit 2."
      },
      "introspection": [
        "GET /__admin/health",
        "GET /__admin",
        "GET /__admin/state",
        "GET /__admin/requests",
        "GET /__admin/metrics",
        "GET /__admin/faults/presets",
        "GET /__admin/ui"
      ],
      "reporting": "https://github.com/crvouga/emulates/blob/main/docs/REPORTING_ISSUES.md"
    }
  },
  "scripts": {
    "generate": "bun ../../openapi/codegen/dist/cli.js",
    "generate:check": "bun ../../openapi/codegen/dist/cli.js --check",
    "openapi:check": "bun ../../openapi/codegen/dist/cli.js --validate",
    "build": "bun ../../../scripts/bundle-service.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "test": "bun test --timeout 30000",
    "parity": "bun scripts/parity.ts",
    "portability": "bun ../../../scripts/portability.ts",
    "pack:check": "bun ../../../scripts/pack-check.ts"
  },
  "dependencies": {
    "@emulates/sqlite": "workspace:*"
  },
  "devDependencies": {
    "@emulates/adapter-node": "workspace:*",
    "@emulates/core": "workspace:*",
    "@emulates/openapi": "workspace:*",
    "@emulates/openapi-codegen": "workspace:*",
    "@emulates/service": "workspace:*",
    "@emulates/ui": "workspace:*",
    "@emulates/sqlite-client": "workspace:*",
    "@emulates/testing": "workspace:*",
    "fast-check": "4.5.3",
    "jose": "6.1.3",
    "oauth4webapi": "3.8.8",
    "hono": "4.11.9"
  }
}
