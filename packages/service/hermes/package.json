{
  "name": "@emulates/hermes",
  "version": "0.0.0-development",
  "description": "Hermes peer-run API emulator with portable scripted lifecycle controls.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "API_EVIDENCE.md",
    "SUPPORT.md",
    "oracle",
    "evidence",
    "DISCOVERY.md",
    "openapi.yaml"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "bin": {
    "emulates-hermes": "./dist/cli.js"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crvouga/emulates.git",
    "directory": "packages/service/hermes"
  },
  "homepage": "https://github.com/crvouga/emulates/tree/main/packages/service/hermes#readme",
  "keywords": [
    "emulates",
    "service",
    "hermes",
    "peer-runs"
  ],
  "emulates": {
    "runtime": "portable",
    "entries": {
      "server": "node",
      "cli": "node"
    },
    "layer": "service",
    "category": "infrastructure",
    "displayName": "Hermes Agent",
    "vendor": {
      "website": "https://hermes-agent.nousresearch.com",
      "docs": "https://hermes-agent.nousresearch.com/docs/user-guide/features/api-server/",
      "description": "Hermes Agent exposes asynchronous public peer-run APIs."
    },
    "status": "wip",
    "playground": {
      "operation": "RunCreate"
    },
    "parity": "Pinned Hermes run lifecycle and recovery",
    "discovery": {
      "guide": "DISCOVERY.md",
      "behavior": "README.md",
      "capabilities": "SUPPORT.md",
      "contract": "openapi.yaml",
      "types": "dist/index.d.ts",
      "oracle": {
        "kind": "Live vendor API or sandbox",
        "command": "bun run parity:service -- hermes",
        "note": "Run from an Emulates checkout; credentials come only from .env.local or GitHub Actions secrets. Missing credentials exit 2."
      },
      "introspection": [
        "GET /__admin/health",
        "GET /__admin",
        "GET /__admin/state",
        "GET /__admin/requests",
        "GET /__admin/metrics",
        "GET /__admin/faults/presets",
        "GET /__admin/ui"
      ],
      "reporting": "https://github.com/crvouga/emulates/blob/main/docs/REPORTING_ISSUES.md"
    }
  },
  "scripts": {
    "generate": "bun ../../openapi/codegen/dist/cli.js",
    "generate:check": "bun ../../openapi/codegen/dist/cli.js --check",
    "openapi:check": "bun ../../openapi/codegen/dist/cli.js --validate",
    "build": "bun ../../../scripts/bundle-service.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "test": "bun test",
    "portability": "bun ../../../scripts/portability.ts",
    "pack:check": "bun ../../../scripts/pack-check.ts"
  },
  "dependencies": {
    "@emulates/sqlite": "workspace:*",
    "hono": "4.11.9"
  },
  "devDependencies": {
    "@emulates/parity": "workspace:*",
    "@emulates/testing": "workspace:*",
    "@emulates/openapi-codegen": "workspace:*",
    "@emulates/core": "workspace:*",
    "@emulates/sqlite-client": "workspace:*",
    "@emulates/openapi": "workspace:*",
    "@emulates/service": "workspace:*",
    "@emulates/adapter-node": "workspace:*"
  }
}
