{
  "name": "@emulates/stripe",
  "version": "0.0.0-development",
  "description": "Stateful emulator of the Stripe API (accounts by key, customers, payments, subscriptions that renew, pause, resume and cancel, invoices, checkout with a hosted page, a hosted customer portal, a Stripe.js stand-in, signed webhooks) at API versions 2024-06-20 and 2025-02-24.acacia, verified by differential property tests against Stripe test mode.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "DISCOVERY.md",
    "SUPPORT.md",
    "openapi.yaml"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "bin": {
    "emulates-stripe": "./dist/cli.js"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crvouga/emulators.git",
    "directory": "packages/service/stripe"
  },
  "homepage": "https://github.com/crvouga/emulators/tree/main/packages/service/stripe#readme",
  "keywords": [
    "emulates",
    "service",
    "stripe",
    "payments",
    "checkout",
    "customer-portal",
    "webhooks",
    "billing"
  ],
  "emulates": {
    "runtime": "portable",
    "entries": {
      "server": "node",
      "cli": "node"
    },
    "layer": "service",
    "category": "payments",
    "displayName": "Stripe",
    "vendor": {
      "website": "https://stripe.com",
      "docs": "https://docs.stripe.com/api"
    },
    "parity": "Payments, billing, and webhooks",
    "parityTier": "cold",
    "playground": {
      "operation": "PostCustomers",
      "headers": {
        "authorization": "Bearer sk_test_emulators"
      }
    },
    "discovery": {
      "guide": "DISCOVERY.md",
      "behavior": "README.md",
      "capabilities": "SUPPORT.md",
      "contract": "openapi.yaml",
      "types": "dist/index.d.ts",
      "oracle": {
        "kind": "Live vendor API or sandbox",
        "command": "bun run parity:service -- stripe",
        "note": "Run from an Emulates checkout; credentials come only from .env.local or GitHub Actions secrets. Missing credentials exit 2."
      },
      "introspection": [
        "GET /__admin/health",
        "GET /__admin",
        "GET /__admin/state",
        "GET /__admin/requests",
        "GET /__admin/metrics",
        "GET /__admin/faults/presets",
        "GET /__admin/ui"
      ],
      "reporting": "https://github.com/crvouga/emulators/blob/main/docs/REPORTING_ISSUES.md"
    }
  },
  "scripts": {
    "vendor": "bun scripts/vendor.ts",
    "generate": "bun ../../openapi/codegen/dist/cli.js",
    "generate:check": "bun ../../openapi/codegen/dist/cli.js --check",
    "openapi:check": "bun ../../openapi/codegen/dist/cli.js --validate",
    "build": "bun ../../../scripts/bundle-service.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.scripts.json --noEmit",
    "lint": "biome check .",
    "test": "bun test",
    "mock:server": "bun scripts/server.ts",
    "client-parity": "bun scripts/client-parity.ts",
    "parity": "bun scripts/parity.ts",
    "pack:check": "bun ../../../scripts/pack-check.ts",
    "portability": "bun ../../../scripts/portability.ts"
  },
  "dependencies": {
    "@emulates/sqlite": "workspace:*",
    "hono": "4.11.9"
  },
  "devDependencies": {
    "fast-check": "4.9.0",
    "@emulates/testing": "workspace:*",
    "@emulates/adapter-bun": "workspace:*",
    "@emulates/sqlite": "workspace:*",
    "@emulates/parity": "workspace:*",
    "@emulates/webhook-collector": "workspace:*",
    "@emulates/model": "workspace:*",
    "@emulates/canonicalize": "workspace:*",
    "@emulates/credentials": "workspace:*",
    "stripe": "16.12.0",
    "yaml": "2.9.0",
    "@emulates/openapi-codegen": "workspace:*",
    "@emulates/openapi-metadata": "workspace:*",
    "@emulates/core": "workspace:*",
    "@emulates/sqlite-client": "workspace:*",
    "@emulates/openapi": "workspace:*",
    "@emulates/service": "workspace:*",
    "@emulates/ui": "workspace:*",
    "@emulates/http-codec": "workspace:*",
    "@emulates/commands": "workspace:*",
    "@emulates/adapter-node": "workspace:*",
    "stripe-v17": "npm:stripe@17.7.0"
  }
}
