---
import Icon from "../components/Icon.astro"
import Mark from "../components/Mark.astro"
import Base from "../layouts/Base.astro"
import { IDENTITY, MARK_REPO_PATH } from "../lib/content.ts"

const swatches = [
  { name: "Paper", token: "--bg", note: "The page" },
  { name: "Ink", token: "--fg", note: "Text and rules" },
  { name: "Live oak", token: "--accent", note: "A filled action" },
  { name: "Clay", token: "--clay", note: "Labels, the current page" },
  { name: "Sage", token: "--sage", note: "A strong border" },
  { name: "Highlight", token: "--highlight", note: "One highlight. Never a fill" },
]
---

<Base title="Brand" description={`The ${IDENTITY.name} mark, sentence, colors and type.`}>
  <div class="container">
    <header class="page-head">
      <span class="eyebrow">Identity</span>
      <h1>Brand</h1>
      <p class="lede">The mark, the sentence, and the live design tokens. The written rules are the <a href="/docs/design">Design guide</a>.</p>
    </header>

    <div class="marks">
      <figure class="mark-card">
        <Mark size={160} />
        <figcaption>
          <span>The mark</span>
          <span>Favicon, header, footer, README. <code>{MARK_REPO_PATH}</code></span>
        </figcaption>
      </figure>
      <figure class="mark-card">
        <div class="lockup">
          <Mark size={56} />
          <span>{IDENTITY.name}</span>
        </div>
        <figcaption>
          <span>The lockup</span>
          <span>The mark beside the name, as in the site header.</span>
        </figcaption>
      </figure>
    </div>

    <section class="block">
      <div class="section-head">
        <span class="eyebrow">The sentence</span>
        <h2>{IDENTITY.tagline}</h2>
        <p>
          The name and that sentence are <code>project.name</code> and <code>project.description</code> in <code>project.ts</code>, exposed to the site as <code>IDENTITY</code>. The GitHub README, <code>llms.txt</code>, and the first line of every package on npm are generated or checked from it.
          The written rules are the <a href="/docs/design">Design guide</a>, the same file GitHub renders.
        </p>
      </div>
    </section>

    <section class="block">
      <div class="section-head">
        <span class="eyebrow">Color</span>
        <h2>Paper, ink, and two accents.</h2>
        <p>These are the live tokens. Switch theme and the chips follow. The hex values in the Design guide are the light theme.</p>
      </div>
      <ul class="swatches">
        {
          swatches.map((s) => (
            <li>
              <span class="chip" style={`background: var(${s.token})`}></span>
              <span>
                <strong>{s.name}</strong>
                <code>{s.token}</code>
                <span>{s.note}</span>
              </span>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="block">
      <div class="section-head">
        <span class="eyebrow">Type</span>
        <h2>A serif for headings. A sans for the tools.</h2>
      </div>
      <div class="type">
        <p class="display">{IDENTITY.name}</p>
        <p class="sub">{IDENTITY.tagline}</p>
        <p class="ui">Interface text is Avenir Next, then the system sans. Code stays in the system mono. No webfont is loaded.</p>
      </div>
    </section>

    <section class="block">
      <div class="section-head">
        <span class="eyebrow">Motifs</span>
        <h2>Double rules, flat cards, labels.</h2>
      </div>
      <div class="motif">
        <div>
          <div class="double-rule" aria-hidden="true"></div>
          <p>Two rules, thick then thin. The header, the footer, and a prose heading all close with them.</p>
        </div>
        <div class="card-sample">
          <strong>Card</strong>
          <p>A paper rectangle. Almost no radius, no lift. Hover draws a clay bar on the leading edge.</p>
        </div>
      </div>
      <div class="controls">
        <a class="btn btn-primary" href="/services">Primary <Icon name="arrow-right" /></a>
        <a class="btn btn-secondary" href="/docs">Secondary</a>
        <span class="badge badge-ok"><span class="dot"></span>Ok</span>
        <span class="badge badge-warn">Note</span>
        <span class="badge">A badge stays a label</span>
      </div>
    </section>
  </div>
</Base>

<style>
  .marks {
    display: grid;
    grid-template-columns: 240px minmax(0, 1fr);
    gap: 28px;
    align-items: stretch;
  }

  .mark-card {
    display: grid;
    justify-items: center;
    align-content: space-between;
    gap: 12px;
    margin: 0;
    padding: 24px 16px 0;
    border: 1px solid var(--border);
    background: var(--bg-elevated);
  }

  .lockup {
    display: flex;
    align-items: center;
    gap: 16px;
    padding-top: 52px;
    font-family: var(--font-display);
    font-size: 40px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .mark-card figcaption {
    display: flex;
    flex-direction: column;
    gap: 4px;
    justify-self: stretch;
    padding: 10px 2px 14px;
    color: var(--fg-subtle);
    font-size: 13px;
  }

  .mark-card figcaption span:first-child {
    color: var(--clay);
    font-size: 11px;
    font-weight: 650;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .page-head :global(a) {
    color: var(--accent-soft-fg);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .block {
    padding-top: 72px;
  }

  .block :global(code) {
    font-size: 0.86em;
  }

  .block :global(a) {
    color: var(--accent-soft-fg);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .swatches {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr));
    gap: 18px 28px;
  }

  .swatches li {
    display: flex;
    gap: 12px;
    align-items: center;
  }

  .swatches .chip {
    width: 48px;
    height: 48px;
    flex: none;
    border: 1px solid var(--border-strong);
  }

  .swatches strong,
  .swatches code,
  .swatches li span span {
    display: block;
  }

  .swatches strong {
    font-family: var(--font-display);
    font-size: 16px;
  }

  .swatches code {
    color: var(--fg-subtle);
    font-size: 12px;
  }

  .swatches li span span {
    color: var(--fg-muted);
    font-size: 13px;
  }

  .type {
    max-width: 680px;
  }

  .display {
    font-family: var(--font-display);
    font-size: clamp(32px, 4vw, 48px);
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  .sub {
    margin-top: 10px;
    font-family: var(--font-display);
    font-size: 20px;
    color: var(--clay);
  }

  .ui {
    margin-top: 16px;
    max-width: 58ch;
    color: var(--fg-muted);
  }

  .motif {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 28px;
  }

  .motif p {
    margin-top: 14px;
    color: var(--fg-muted);
  }

  .card-sample {
    padding: 16px;
    border: 1px solid var(--border);
    background: var(--bg-elevated);
    transition: border-color 0.15s var(--ease), box-shadow 0.15s var(--ease);
  }

  .card-sample:hover {
    border-color: var(--fg);
    box-shadow: inset 3px 0 0 var(--clay);
  }

  .card-sample strong {
    font-family: var(--font-display);
    font-size: 18px;
  }

  .controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin-top: 28px;
  }

  @media (max-width: 800px) {
    .marks,
    .motif {
      grid-template-columns: 1fr;
    }
  }
</style>
