---
import catalog from "virtual:mockingbird/catalog"
import Icon from "../components/Icon.astro"
import Install from "../components/Install.astro"
import Monogram from "../components/Monogram.astro"
import ServiceCard from "../components/ServiceCard.astro"
import Base from "../layouts/Base.astro"
import {
  AGENTS,
  CONTRACT,
  FEATURES,
  HEADLINE,
  IDENTITY,
  PITCH,
  PLATE_HREF,
  QUICK_START,
} from "../lib/content.ts"
import { inline } from "../lib/inline.ts"

const { totals } = catalog
const ready = catalog.services.filter((s) => s.status === "ready")
const logos = catalog.services.filter((s) => s.kind === "http").slice(0, 18)
---

<Base>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="species">
          <em>Mimus polyglottos</em>
          <a href="/services?tier=ready">{totals.ready} ready to use · {totals.wip} in progress</a>
        </p>
        <h1>{HEADLINE.lead}<br /><em>{HEADLINE.accent}</em></h1>
        <p class="note">{IDENTITY.note}</p>
        <p class="lede" set:html={inline(PITCH)} />
        <div class="hero-cta">
          <a class="btn btn-primary" href="/services">Browse services <Icon name="arrow-right" /></a>
          <a class="btn btn-secondary" href="/why">Why Mockingbird</a>
        </div>
        <div class="hero-install">
          <Install pkg={QUICK_START.package} />
        </div>
      </div>
      <figure class="plate">
        <img
          src={PLATE_HREF}
          width="1536"
          height="1024"
          alt="Northern mockingbird on a fruiting branch: gray above, pale below, two white bars on the wing, a long tail."
        />
        <figcaption>
          <span>Plate I</span>
          <span>Northern mockingbird, singing a call it learned</span>
        </figcaption>
      </figure>
    </div>
  </section>

  <div class="container">
    <section class="stats" aria-label="By the numbers">
    <a href="/services?tier=ready"><strong class="ok">{totals.ready}</strong><span>ready to use</span></a>
    <a href="/services?tier=wip"><strong class="warn">{totals.wip}</strong><span>in progress</span></a>
    <a href="/coverage"><strong>{totals.opsSupported}</strong><span>vendor operations mocked</span></a>
    <div><strong>0</strong><span>network calls</span></div>
  </section>
  </div>

  <section class="section container">
    <div class="section-head">
      <span class="eyebrow">Quick start</span>
      <h2>A call, answered.</h2>
      <p>The README's quick start. The build runs it against the published package.</p>
    </div>
    <div class="window">
      <div class="window-bar">
        <span class="window-mark" aria-hidden="true"></span>
        <span class="window-title">{QUICK_START.file}</span>
        <a href="/services/stripe" class="window-link">Try it live <Icon name="arrow-right" /></a>
      </div>
      <Fragment set:html={catalog.quickStart.html} />
    </div>
  </section>

  <section class="section container ready-section">
    <div class="section-head">
      <span class="eyebrow">Ready to use</span>
      <h2>Start with the {totals.ready} that are ready.</h2>
      <p>
        These are complete and kept stable. The other {totals.wip} are marked work in progress: usable in a suite,
        but their operations and shapes can still change.
      </p>
    </div>
    <div class="ready-grid">
      {ready.map((s) => <ServiceCard service={s} />)}
    </div>
    <a class="more" href="/services?tier=wip">See the {totals.wip} in progress <Icon name="arrow-right" /></a>
  </section>

  <section class="section container">
    <div class="section-head">
      <span class="eyebrow">Why it works</span>
      <h2>Test doubles that don't drift from the vendor.</h2>
      <p>Hand-written stubs return whatever you guessed. Mockingbird mocks are driven by the vendor's contract and checked against it.</p>
    </div>
    <div class="values">
      {
        FEATURES.map((v, i) => (
          <div class="value">
            <span class="value-index">{String(i + 1).padStart(2, "0")}</span>
            <h3>{v.title}</h3>
            <p set:html={inline(v.body)} />
          </div>
        ))
      }
    </div>
  </section>

  <section class="section container">
    <div class="section-head">
      <span class="eyebrow">Catalog</span>
      <h2>Payments, health, messaging, AI, and more.</h2>
      <p>Every category links to a filtered view of the catalog.</p>
    </div>
    <div class="cats">
      {
        catalog.categories.map((c) => {
          const members = catalog.services.filter((s) => s.category === c.slug)
          return (
            <a class="cat" href={`/services?category=${c.slug}`}>
              <div class="cat-head">
                <h3>{c.label}</h3>
                <span>{c.count}</span>
              </div>
              <p>{c.blurb}</p>
              <div class="cat-members">
                {members.slice(0, 5).map((s) => <Monogram name={s.displayName} hue={s.hue} logo={s.brand.logo} size={26} />)}
              </div>
            </a>
          )
        })
      }
    </div>
    <div class="logo-strip" aria-hidden="true">
      {logos.map((s) => <span>{s.displayName}</span>)}
    </div>
  </section>

  <section class="section container">
    <div class="section-head">
      <span class="eyebrow">The service contract</span>
      <h2>One contract for every HTTP service.</h2>
      <p set:html={inline(CONTRACT.intro)} />
    </div>
    <div class="contract">
      <div class="table-wrap">
        <table class="table">
          <thead><tr><th>Surface</th><th>What it gives you</th></tr></thead>
          <tbody>
            {CONTRACT.rows.map(([surface, detail]) => (
              <tr><td set:html={inline(surface)} /><td set:html={inline(detail)} /></tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="contract-note" set:html={inline(CONTRACT.configNote)} />
    </div>
  </section>

  <section class="section container">
    <div class="agents">
      <div>
        <span class="eyebrow">Built for coding agents</span>
        <h2>Docs an agent can read, generated from the code.</h2>
        <p set:html={inline(AGENTS)} />
      </div>
      <ul class="agent-links">
        <li><a href="/llms.txt"><Icon name="bot" /><span><strong>/llms.txt</strong>An index of every service with links to its markdown</span></a></li>
        <li><a href="/llms-full.txt"><Icon name="file" /><span><strong>/llms-full.txt</strong>Every README in one file</span></a></li>
        <li><a href="/catalog.json"><Icon name="database" /><span><strong>/catalog.json</strong>Surfaces, runtimes and operation coverage</span></a></li>
        <li><a href="/services/stripe.md"><Icon name="file" /><span><strong>/services/&lt;name&gt;.md</strong>Any service's README as raw markdown</span></a></li>
      </ul>
    </div>
  </section>

  <section class="cta-band">
    <div class="container cta">
      <h2>Take the vendor off your test suite's critical path.</h2>
      <div class="hero-cta">
        <a class="btn btn-primary" href="/services">Find your API <Icon name="arrow-right" /></a>
        <a class="btn btn-secondary" href={catalog.repo} target="_blank" rel="noopener"><Icon name="github" /> Star on GitHub</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    padding-block: 56px 28px;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: 48px;
    align-items: start;
  }

  .species {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px 16px;
    margin: 0;
    color: var(--clay);
  }

  .species em {
    font-family: var(--font-display);
    font-size: 17px;
  }

  .species a {
    color: var(--fg-muted);
    font-size: 13px;
    text-decoration: underline;
    text-decoration-color: var(--clay);
    text-underline-offset: 3px;
  }

  .species a:hover {
    color: var(--fg);
  }

  .ready-section {
    padding-bottom: 0;
  }

  .ready-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 14px;
  }

  .more {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 18px;
    color: var(--fg-muted);
    font-size: 14px;
    font-weight: 500;
  }

  .more:hover {
    color: var(--fg);
  }

  .more :global(.i) {
    width: 14px;
    height: 14px;
  }

  .stats a:hover strong {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .stats .ok {
    color: var(--ok);
  }

  .stats .warn {
    color: var(--warn);
  }

  .hero h1 {
    margin-top: 14px;
    font-size: clamp(40px, 5vw, 64px);
    line-height: 0.98;
    letter-spacing: -0.03em;
    font-weight: 600;
  }

  .hero h1 em {
    font-style: italic;
    font-weight: 500;
    color: var(--clay);
  }

  .note {
    margin-top: 18px;
    max-width: 42ch;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 18px;
    line-height: 1.45;
  }

  .hero .lede {
    margin-top: 14px;
    max-width: 52ch;
    font-size: 16.5px;
  }

  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 28px;
  }

  .hero-install {
    margin-top: 28px;
    max-width: 480px;
  }

  .plate {
    margin: 0;
    padding: 12px 12px 0;
    border: 1px solid #243f34;
    background: #f3eee4;
  }

  .plate img {
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    background: #111;
  }

  .plate figcaption {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 10px 2px 12px;
    color: #5c675f;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 14px;
  }

  .plate figcaption span:first-child {
    flex: none;
    color: #8d4a32;
    font-family: var(--font-sans);
    font-style: normal;
    font-size: 11px;
    font-weight: 650;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .window :global(.code) {
    margin: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
  }

  .window :global(.code figcaption) {
    display: none;
  }

  .window {
    border: 1px solid var(--fg);
    border-radius: 0;
    background: var(--bg-inset);
    overflow: hidden;
  }

  .window-bar {
    display: flex;
    align-items: center;
    gap: 12px;
    height: 42px;
    padding: 0 12px;
    border-bottom: 1px solid var(--border);
    background: var(--bg-subtle);
  }

  .window-mark {
    width: 22px;
    height: 7px;
    flex: none;
    background-image:
      linear-gradient(var(--fg), var(--fg)),
      linear-gradient(var(--fg), var(--fg));
    background-repeat: no-repeat;
    background-size:
      100% 2px,
      68% 1px;
    background-position:
      left top,
      left 5px;
  }

  .window-title {
    flex: 1;
    color: var(--fg-subtle);
    font-family: var(--font-mono);
    font-size: 12px;
  }

  .window-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: var(--accent-soft-fg);
    font-size: 12.5px;
    font-weight: 600;
  }

  .window-link .i {
    width: 13px;
    height: 13px;
  }

  .window :global(pre) {
    margin: 0;
    padding: 16px 18px;
    max-height: 440px;
    overflow: auto;
    font-size: 12.5px;
    line-height: 1.7;
    background: transparent !important;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin-top: 28px;
    border-block: 1px solid var(--border);
    background: transparent;
  }

  .stats > * {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 22px 24px;
  }

  .stats > * + * {
    border-left: 1px solid var(--border);
  }

  .stats strong {
    font-family: var(--font-display);
    font-size: 34px;
    font-weight: 560;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
  }

  .stats span {
    color: var(--fg-subtle);
    font-size: 13.5px;
  }

  .values {
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: 56px;
  }

  .value {
    padding: 22px 0 28px;
    background-image:
      linear-gradient(var(--fg), var(--fg)),
      linear-gradient(var(--fg), var(--fg));
    background-repeat: no-repeat;
    background-size:
      28px 2px,
      18px 1px;
    background-position:
      left top,
      left 5px;
  }

  .value-index {
    display: block;
    margin-top: 12px;
    color: var(--clay);
    font-family: var(--font-display);
    font-style: italic;
    font-size: 18px;
  }

  .value h3 {
    margin-top: 6px;
    font-size: 20px;
  }

  .value p {
    margin-top: 8px;
    color: var(--fg-muted);
    font-size: 14px;
    line-height: 1.6;
  }

  .cats {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 14px;
  }

  .cat {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 18px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-elevated);
    transition: border-color 0.15s var(--ease), box-shadow 0.15s var(--ease);
  }

  .cat:hover {
    border-color: var(--fg);
    box-shadow: inset 3px 0 0 var(--clay);
  }

  .cat-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }

  .cat-head h3 {
    font-size: 15px;
  }

  .cat-head span {
    color: var(--fg-subtle);
    font-size: 13px;
    font-variant-numeric: tabular-nums;
  }

  .cat p {
    color: var(--fg-muted);
    font-size: 13.5px;
  }

  .cat-members {
    display: flex;
    gap: 4px;
    margin-top: 6px;
  }

  .logo-strip {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px 26px;
    margin-top: 40px;
    color: var(--fg-faint);
    font-family: var(--font-display);
    font-style: italic;
    font-size: 16px;
    font-weight: 500;
  }

  .contract-note {
    margin-top: 14px;
    max-width: 760px;
    color: var(--fg-muted);
    font-size: 14px;
  }

  .contract td :global(code),
  .contract-note :global(code),
  .value p :global(code),
  .agents p :global(code) {
    padding: 1px 5px;
    border: 1px solid var(--border);
    border-radius: 5px;
    background: var(--bg-muted);
    font-size: 0.86em;
  }

  .agents p :global(a) {
    color: var(--accent-soft-fg);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .agents {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: center;
    padding: 36px 0 0;
    border: 0;
    border-radius: 0;
    background-color: transparent;
    background-image:
      linear-gradient(var(--fg), var(--fg)),
      linear-gradient(var(--fg), var(--fg));
    background-repeat: no-repeat;
    background-size:
      100% 2px,
      100% 1px;
    background-position:
      left top,
      left 4px;
  }

  .agents h2 {
    margin-top: 10px;
    font-size: clamp(24px, 3vw, 30px);
  }

  .agents p {
    margin-top: 14px;
    color: var(--fg-muted);
  }

  .agent-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 8px;
  }

  .agent-links a {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    padding: 12px 0;
    border: 0;
    border-bottom: 1px solid var(--border);
    border-radius: 0;
    background: transparent;
    transition: border-color 0.15s var(--ease);
  }

  .agent-links a:hover {
    border-color: var(--border-strong);
  }

  .agent-links .i {
    margin-top: 2px;
    color: var(--accent-soft-fg);
  }

  .agent-links strong {
    display: block;
    font-family: var(--font-mono);
    font-size: 13px;
  }

  .agent-links span span,
  .agent-links a > span {
    color: var(--fg-muted);
    font-size: 13.5px;
  }

  .cta-band {
    margin-top: 80px;
    padding: 72px 0 80px;
    background: var(--accent);
    color: var(--accent-fg);
  }

  .cta h2 {
    max-width: 18em;
    font-size: clamp(28px, 4vw, 44px);
    line-height: 1.05;
  }

  .cta-band .btn-primary {
    background: var(--accent-fg);
    color: var(--accent);
  }

  .cta-band .btn-primary:hover {
    background: var(--bg);
  }

  .cta-band .btn-secondary {
    background: transparent;
    color: var(--accent-fg);
    border-color: color-mix(in srgb, var(--accent-fg) 45%, transparent);
    box-shadow: none;
  }

  .cta-band .btn-secondary:hover {
    background: color-mix(in srgb, var(--accent-fg) 12%, transparent);
    border-color: var(--accent-fg);
  }

  @media (max-width: 960px) {
    .hero-grid,
    .agents {
      grid-template-columns: minmax(0, 1fr);
    }
    .plate {
      max-width: 640px;
    }
  }

  @media (max-width: 640px) {
    .hero {
      padding-top: 40px;
    }
    .stats {
      grid-template-columns: 1fr 1fr;
    }
    .stats > :nth-child(3) {
      border-left: 0;
    }
    .stats > :nth-child(n + 3) {
      border-top: 1px solid var(--border);
    }
    .values {
      grid-template-columns: 1fr;
    }
    .agents {
      padding-top: 28px;
    }
  }
</style>
