---
import catalog from "virtual:mockingbird/catalog"
import { highlightSource } from "../../integrations/catalog/markdown.ts"
import Icon from "../components/Icon.astro"
import Install from "../components/Install.astro"
import BrowserStack from "../components/landing/BrowserStack.astro"
import EmulatedServices from "../components/landing/EmulatedServices.astro"
import Monogram from "../components/Monogram.astro"
import QuickStart from "../components/QuickStart.astro"
import ServiceCard from "../components/ServiceCard.astro"
import Base from "../layouts/Base.astro"
import { AGENTS, CONTRACT, FEATURES, HEADLINE, PITCH, QUICK_START } from "../lib/content.ts"
import { inline } from "../lib/inline.ts"

const { totals } = catalog
const featured = catalog.services.filter((s) => s.featured)
const request = `import { createRuntime } from
  "@crvouga/mockingbird-service-stripe"

const stripe = createRuntime()

const response = await stripe.fetch(
  new Request("https://api.stripe.com/v1/customers", {
    method: "POST",
    headers: {
      authorization: "Bearer sk_test_mockingbird",
      "content-type": "application/x-www-form-urlencoded",
    },
    body: "email=ada@example.com",
  }),
)`
const requestHtml = await highlightSource(request, "ts")
---

<Base>
  <section class="hero container">
    <div class="hero-copy">
      <p class="eyebrow"><span class="runtime-dot" aria-hidden="true"></span> API & database emulation</p>
      <h1>{HEADLINE.lead}<br /><span>{HEADLINE.accent}</span></h1>
      <p class="lede" set:html={inline(PITCH)} />
      <div class="hero-actions">
        <a class="btn btn-primary" href="/docs/getting-started">Get started <Icon name="arrow-right" /></a>
        <a class="btn btn-secondary" href="/services">Explore emulators</a>
      </div>
      <div class="hero-install"><Install pkg={QUICK_START.package} /></div>
      <p class="runtime-list">Node.js <span>·</span> Bun <span>·</span> Browser <span>·</span> Workers</p>
    </div>
    <div class="runtime-panel" aria-label="Stripe emulator request example">
      <div class="panel-bar"><Icon name="terminal" /><span>stripe.test.ts</span><span class="badge badge-ok">In-process</span></div>
      <Fragment set:html={requestHtml} />
      <div class="response-line"><span class="method" data-m="POST">POST</span><code>/v1/customers</code><span class="badge badge-ok">200 OK</span></div>
      <div class="panel-foot"><span class="runtime-dot" aria-hidden="true"></span> Stateful runtime <span class="panel-foot-end">No external requests</span></div>
    </div>
  </section>

  <div class="container">
    <section class="stats" aria-label="Emulator capabilities">
      <a href="/services"><strong>{totals.services}</strong><span>service emulators</span></a>
      <a href="/coverage"><strong>{totals.opsSupported}</strong><span>supported vendor operations</span></a>
      <div><strong>4</strong><span>JavaScript runtimes</span></div>
    </section>
  </div>

  <section class="section container" id="quick-start">
    <div class="section-head">
      <span class="eyebrow">01 / Quick start</span>
      <h2>From product data to a paid order.</h2>
      <p>Build a checkout with PostgreSQL and Stripe emulators. Seed the data, write an API, and place an order from a client. Every step runs in your process.</p>
    </div>
    <QuickStart />
  </section>

  <section class="section container">
    <div class="section-head">
      <span class="eyebrow">02 / Architecture</span>
      <h2>Your application. Your SDKs. Local emulators.</h2>
      <p>Each emulator implements the vendor's request and response shapes inside your process. Inject its Fetch handler or serve it on a local port.</p>
    </div>
    <EmulatedServices />
  </section>

  <section class="section container">
    <div class="section-head">
      <span class="eyebrow">03 / Runtime controls</span>
      <h2>Reproducible behavior, with explicit coverage.</h2>
      <p>Emulate the operations your application uses, inspect supported behavior, and control state between runs.</p>
    </div>
    <div class="features">
      {FEATURES.map((feature) => (
        <div class="feature">
          <span class="feature-icon"><Icon name={feature.icon} /></span>
          <h3>{feature.title}</h3>
          <p set:html={inline(feature.body)} />
        </div>
      ))}
    </div>
  </section>

  <section class="section container">
    <div class="section-head section-head-row">
      <div><span class="eyebrow">04 / Emulator catalog</span><h2>Find your application's dependencies.</h2></div>
      <a class="text-link" href="/services">All {totals.services} emulators <Icon name="arrow-right" /></a>
    </div>
    <div class="featured-head"><h3><Icon name="star" /> Featured emulators</h3><a class="text-link" href="/services?featured=1">View featured <Icon name="arrow-right" /></a></div>
    <p class="featured-intro">Start with payments, SQL, object storage, or healthcare integrations. Open an emulator to explore its contract and try the playground.</p>
    <div class="featured-grid">{featured.map((service) => <ServiceCard service={service} />)}</div>
    <div class="categories">
      {catalog.categories.map((category) => {
        const members = catalog.services.filter((service) => service.category === category.slug)
        return (
          <a class="category" href={`/services?category=${category.slug}`}>
            <div class="category-heading"><h3>{category.label}</h3><span>{category.count}</span></div>
            <p>{category.blurb}</p>
            <div class="category-members">{members.slice(0, 5).map((service) => <Monogram name={service.displayName} hue={service.hue} logo={service.brand.logo} size={28} />)}</div>
          </a>
        )
      })}
    </div>
  </section>

  <section class="section container">
    <div class="section-head">
      <span class="eyebrow">05 / Interactive example</span>
      <h2>A complete application, running in your browser.</h2>
      <p>The client, server, database emulator, and API emulators share one browser tab. Explore the application and its state without configuring a server.</p>
    </div>
    <BrowserStack />
  </section>

  <section class="section container">
    <div class="section-head">
      <span class="eyebrow">06 / Service interface</span>
      <h2>A shared control plane for every HTTP emulator.</h2>
      <p set:html={inline(CONTRACT.intro)} />
    </div>
    <div class="table-wrap">
      <table class="table">
        <thead><tr><th>Interface</th><th>Behavior</th></tr></thead>
        <tbody>{CONTRACT.rows.map(([surface, detail]) => <tr><td set:html={inline(surface)} /><td set:html={inline(detail)} /></tr>)}</tbody>
      </table>
    </div>
    <p class="contract-note" set:html={inline(CONTRACT.configNote)} />
  </section>

  <section class="section container">
    <div class="agent-docs">
      <div><span class="eyebrow">Machine-readable documentation</span><h2>Source-backed guides for developers and agents.</h2><p set:html={inline(AGENTS)} /></div>
      <ul>
        <li><a href="/llms.txt"><Icon name="bot" /><span><strong>/llms.txt</strong>Emulator index and declared parity</span><Icon name="arrow-right" /></a></li>
        <li><a href="/llms-full.txt"><Icon name="file" /><span><strong>/llms-full.txt</strong>Every package guide in one file</span><Icon name="arrow-right" /></a></li>
        <li><a href="/catalog.json"><Icon name="database" /><span><strong>/catalog.json</strong>Interfaces and operation coverage</span><Icon name="arrow-right" /></a></li>
        <li><a href="/services/stripe.md"><Icon name="file" /><span><strong>/services/&lt;name&gt;.md</strong>Raw markdown for each emulator</span><Icon name="arrow-right" /></a></li>
      </ul>
    </div>
  </section>
</Base>

<script>
  import "../client/appExamples.ts"
</script>

<style>
  .hero { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 56px; align-items: center; padding-block: 72px 56px; }
  .hero .eyebrow { display: flex; align-items: center; gap: 8px; }
  .runtime-dot { display: inline-block; width: 6px; height: 6px; border-radius: 50%; background: var(--ok); flex: none; }
  .hero h1 { margin-top: 20px; font-size: clamp(34px, 4.2vw, 56px); line-height: 1.12; letter-spacing: -0.045em; font-weight: 700; }
  .hero h1 span { color: var(--highlight); }
  .hero .lede { margin-top: 22px; max-width: 54ch; font-size: 16px; line-height: 1.75; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 28px; }
  .hero-install { margin-top: 28px; min-width: 0; }
  .runtime-list { margin-top: 14px; color: var(--fg-subtle); font-family: var(--font-mono); font-size: 11px; }
  .runtime-list span { padding-inline: 8px; color: var(--fg-faint); }
  .runtime-panel { min-width: 0; border: 1px solid var(--border); border-radius: var(--radius-lg); background: var(--bg-elevated); overflow: hidden; box-shadow: var(--shadow-md); }
  .panel-bar { display: flex; align-items: center; gap: 10px; padding: 12px 16px; background: var(--bg-subtle); border-bottom: 1px solid var(--border); font-family: var(--font-mono); font-size: 12px; color: var(--fg-muted); }
  .panel-bar .badge { margin-left: auto; font-family: var(--font-sans); }
  .runtime-panel :global(pre) { margin: 0; padding: 22px 20px; font-size: 12px; line-height: 1.85; overflow-x: auto; background: transparent !important; }
  .runtime-panel :global(pre code) { font-size: inherit; }
  .featured-head { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-top: 28px; }
  .featured-head h3 { display: flex; align-items: center; gap: 8px; font-size: 15px; }
  .featured-head h3 :global(.i) { width: 16px; height: 16px; color: var(--highlight); fill: var(--accent-soft); }
  .featured-intro { margin-top: 8px; font-size: 13px; color: var(--fg-muted); }
  .featured-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 250px), 1fr)); gap: 14px; margin: 20px 0 32px; }
  .response-line { display: flex; align-items: center; gap: 8px; margin: 0 16px 16px; padding: 12px; background: var(--bg-subtle); border: 1px solid var(--border); border-radius: var(--radius-sm); font-size: 12px; }
  .response-line .badge { margin-left: auto; }
  .panel-foot { display: flex; align-items: center; gap: 8px; padding: 12px 16px; border-top: 1px solid var(--border); color: var(--fg-subtle); font-family: var(--font-mono); font-size: 10px; }
  .panel-foot-end { margin-left: auto; }
  .stats a:hover strong { color: var(--highlight); }
  .stats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-block: 1px solid var(--border); }
  .stats > * { display: flex; align-items: center; gap: 16px; padding: 24px; }
  .stats > * + * { border-left: 1px solid var(--border); }
  .stats strong { font-family: var(--font-mono); font-size: 28px; font-weight: 600; letter-spacing: -0.04em; }
  .stats span { color: var(--fg-subtle); font-size: 12px; }
  .features { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: 1px solid var(--border); border-left: 1px solid var(--border); border-radius: var(--radius-lg); overflow: hidden; }
  .feature { padding: 28px; border-bottom: 1px solid var(--border); border-right: 1px solid var(--border); }
  .feature-icon { display: inline-flex; padding: 8px; margin-bottom: 18px; border: 1px solid var(--border); border-radius: var(--radius); color: var(--highlight); }
  .feature h3 { font-size: 16px; font-weight: 650; }
  .feature p { margin-top: 10px; font-size: 14px; line-height: 1.65; color: var(--fg-muted); }
  .section-head-row { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 20px; }
  .section-head-row h2 { margin-top: 8px; }
  .text-link { display: inline-flex; align-items: center; gap: 8px; color: var(--highlight); font-size: 13px; }
  .categories { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; }
  .category { padding: 22px; border: 1px solid var(--border); border-radius: var(--radius-lg); background: var(--bg-elevated); transition: border-color 0.15s var(--ease); }
  .category:hover { border-color: var(--highlight); }
  .category-heading { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .category-heading h3 { font-size: 15px; }
  .category-heading > span { font-family: var(--font-mono); font-size: 12px; color: var(--fg-subtle); }
  .category p { margin-top: 10px; color: var(--fg-subtle); font-size: 13px; }
  .category-members { display: flex; gap: 8px; margin-top: 20px; }
  .contract-note { margin-top: 14px; color: var(--fg-subtle); font-size: 13px; }
  .agent-docs { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 56px; padding: 32px; border: 1px solid var(--border); border-radius: var(--radius-lg); background: var(--bg-subtle); }
  .agent-docs h2 { margin-top: 10px; font-size: 26px; }
  .agent-docs p { margin-top: 16px; color: var(--fg-muted); font-size: 14px; }
  .agent-docs ul { margin: 0; padding: 0; list-style: none; }
  .agent-docs li + li { border-top: 1px solid var(--border); }
  .agent-docs a { display: flex; align-items: center; gap: 12px; padding: 14px 0; }
  .agent-docs a > span { flex: 1; color: var(--fg-subtle); font-size: 12px; }
  .agent-docs strong { display: block; font-family: var(--font-mono); color: var(--fg); font-size: 13px; margin-bottom: 4px; }
  .agent-docs a:hover strong { color: var(--highlight); }
  @media (max-width: 1000px) { .hero { gap: 32px; } .features, .categories { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 800px) { .hero { grid-template-columns: minmax(0, 1fr); padding-block: 40px; } .hero h1 { font-size: clamp(36px, 7vw, 52px); } .agent-docs { grid-template-columns: minmax(0, 1fr); gap: 24px; padding: 24px; } }
  @media (max-width: 560px) { .features, .categories { grid-template-columns: minmax(0, 1fr); } .runtime-list { font-size: 10px; } .runtime-list span { padding-inline: 4px; } .panel-foot-end { display: none; } .stats { grid-template-columns: minmax(0, 1fr); } .stats > * + * { border-left: 0; border-top: 1px solid var(--border); } .stats > * { padding: 16px; } .stats strong { min-width: 4ch; } }
</style>
