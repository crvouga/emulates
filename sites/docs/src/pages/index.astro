---
import catalog from "virtual:emulators/catalog"
import Icon from "../components/Icon.astro"
import Install from "../components/Install.astro"
import BrowserStack from "../components/landing/BrowserStack.astro"
import EmulatedServices from "../components/landing/EmulatedServices.astro"
import Mark from "../components/Mark.astro"
import Monogram from "../components/Monogram.astro"
import Base from "../layouts/Base.astro"
import { AGENTS, CONTRACT, FEATURES, IDENTITY, PITCH, QUICK_START } from "../lib/content.ts"
import { inline } from "../lib/inline.ts"

const { totals } = catalog
const logos = catalog.services.filter((s) => s.kind === "http").slice(0, 18)
---

<Base>
  <section class="hero">
    <div class="container hero-inner">
      <p class="hero-kicker">
        <Mark size={40} />
        <a href="/services">{totals.services} emulators</a>
      </p>
      <h1>{IDENTITY.name}</h1>
      <p class="tagline">{IDENTITY.tagline}</p>
      <p class="lede" set:html={inline(PITCH)} />
      <div class="hero-cta">
        <a class="btn btn-primary" href="/services">Browse emulators <Icon name="arrow-right" /></a>
        <a class="btn btn-secondary" href="/why">Why {IDENTITY.name}</a>
      </div>
      <div class="hero-install">
        <Install pkg={QUICK_START.package} />
      </div>
    </div>
  </section>

  <div class="container">
    <section class="stats" aria-label="By the numbers">
    <a href="/services"><strong>{totals.services}</strong><span>emulators</span></a>
    <a href="/coverage"><strong>{totals.opsSupported}</strong><span>vendor operations emulated</span></a>
    <div><strong>0</strong><span>network calls</span></div>
  </section>
  </div>

  <section class="section container">
    <div class="section-head">
      <span class="eyebrow">What it does</span>
      <h2>A stand-in for every service your app calls.</h2>
      <p>Each third-party API your app depends on gets a high-fidelity emulator that runs in your process. Your code and the vendor's SDK stay the same; the requests just never leave.</p>
    </div>
    <EmulatedServices />
  </section>

  <section class="section container">
    <div class="section-head">
      <span class="eyebrow">Quick start</span>
      <h2>A call, answered.</h2>
      <p>The README's quick start. The build runs it against the published package.</p>
    </div>
    <div class="window">
      <div class="window-bar">
        <span class="window-mark" aria-hidden="true"></span>
        <span class="window-title">{QUICK_START.file}</span>
        <a href="/services/stripe" class="window-link">Try it live <Icon name="arrow-right" /></a>
      </div>
      <Fragment set:html={catalog.quickStart.html} />
    </div>
  </section>

  <section class="section container fullstack">
    <div class="section-head">
      <span class="eyebrow">Full stack, in a browser tab</span>
      <h2>Build and test a whole app with no server.</h2>
      <p>Emulates run wherever JavaScript does, so an app's client, its API, and every vendor it calls can share one browser tab.</p>
    </div>
    <BrowserStack />
  </section>

  <section class="section container">
    <div class="section-head">
      <span class="eyebrow">Why it works</span>
      <h2>Emulates, not mocks.</h2>
      <p>A hand-written mock returns whatever you guessed. An emulator is driven by the vendor's contract, keeps real state, and is checked against the real implementation.</p>
    </div>
    <div class="values">
      {
        FEATURES.map((v, i) => (
          <div class="value">
            <span class="value-index">{String(i + 1).padStart(2, "0")}</span>
            <h3>{v.title}</h3>
            <p set:html={inline(v.body)} />
          </div>
        ))
      }
    </div>
  </section>

  <section class="section container">
    <div class="section-head">
      <span class="eyebrow">Catalog</span>
      <h2>Payments, health, messaging, AI, and more.</h2>
      <p>Every category links to a filtered view of the catalog.</p>
    </div>
    <div class="cats">
      {
        catalog.categories.map((c) => {
          const members = catalog.services.filter((s) => s.category === c.slug)
          return (
            <a class="cat" href={`/services?category=${c.slug}`}>
              <div class="cat-head">
                <h3>{c.label}</h3>
                <span>{c.count}</span>
              </div>
              <p>{c.blurb}</p>
              <div class="cat-members">
                {members.slice(0, 5).map((s) => <Monogram name={s.displayName} hue={s.hue} logo={s.brand.logo} size={26} />)}
              </div>
            </a>
          )
        })
      }
    </div>
    <div class="logo-strip" aria-hidden="true">
      {logos.map((s) => <span>{s.displayName}</span>)}
    </div>
  </section>

  <section class="section container">
    <div class="section-head">
      <span class="eyebrow">The service contract</span>
      <h2>One contract for every HTTP service.</h2>
      <p set:html={inline(CONTRACT.intro)} />
    </div>
    <div class="contract">
      <div class="table-wrap">
        <table class="table">
          <thead><tr><th>Surface</th><th>What it gives you</th></tr></thead>
          <tbody>
            {CONTRACT.rows.map(([surface, detail]) => (
              <tr><td set:html={inline(surface)} /><td set:html={inline(detail)} /></tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="contract-note" set:html={inline(CONTRACT.configNote)} />
    </div>
  </section>

  <section class="section container">
    <div class="agents">
      <div>
        <span class="eyebrow">Built for coding agents</span>
        <h2>Docs an agent can read, generated from the code.</h2>
        <p set:html={inline(AGENTS)} />
      </div>
      <ul class="agent-links">
        <li><a href="/llms.txt"><Icon name="bot" /><span><strong>/llms.txt</strong>An index of every service with links to its markdown</span></a></li>
        <li><a href="/llms-full.txt"><Icon name="file" /><span><strong>/llms-full.txt</strong>Every README in one file</span></a></li>
        <li><a href="/catalog.json"><Icon name="database" /><span><strong>/catalog.json</strong>Surfaces and operation coverage</span></a></li>
        <li><a href="/services/stripe.md"><Icon name="file" /><span><strong>/services/&lt;name&gt;.md</strong>Any service's README as raw markdown</span></a></li>
      </ul>
    </div>
  </section>

  <section class="cta-band">
    <div class="container cta">
      <h2>Take the vendor off your test suite's critical path.</h2>
      <div class="hero-cta">
        <a class="btn btn-primary" href="/services">Find your API <Icon name="arrow-right" /></a>
        <a class="btn btn-secondary" href={catalog.repo} target="_blank" rel="noopener"><Icon name="github" /> Star on GitHub</a>
      </div>
    </div>
  </section>
</Base>

<script>
  import "../client/appExamples.ts"
</script>

<style>
  .hero {
    padding-block: 56px 28px;
  }

  .hero-inner {
    max-width: 820px;
  }

  .hero-kicker {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 14px;
    margin: 0;
  }

  .hero-kicker a {
    color: var(--fg-muted);
    font-size: 13px;
    text-decoration: underline;
    text-decoration-color: var(--clay);
    text-underline-offset: 3px;
  }

  .hero-kicker a:hover {
    color: var(--fg);
  }

  .stats a:hover strong {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .hero h1 {
    margin-top: 14px;
    font-size: clamp(40px, 5vw, 64px);
    line-height: 0.98;
    letter-spacing: -0.03em;
    font-weight: 600;
  }

  .tagline {
    margin-top: 16px;
    max-width: 30ch;
    font-family: var(--font-display);
    font-size: clamp(22px, 2.6vw, 30px);
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--clay);
  }

  .hero .lede {
    margin-top: 14px;
    max-width: 52ch;
    font-size: 16.5px;
  }

  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 28px;
  }

  .hero-install {
    margin-top: 28px;
    max-width: 480px;
  }

  .window :global(.code) {
    margin: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
  }

  .window :global(.code figcaption) {
    display: none;
  }

  .window {
    border: 1px solid var(--fg);
    border-radius: 0;
    background: var(--bg-inset);
    overflow: hidden;
  }

  .window-bar {
    display: flex;
    align-items: center;
    gap: 12px;
    height: 42px;
    padding: 0 12px;
    border-bottom: 1px solid var(--border);
    background: var(--bg-subtle);
  }

  .window-mark {
    width: 22px;
    height: 7px;
    flex: none;
    background-image:
      linear-gradient(var(--fg), var(--fg)),
      linear-gradient(var(--fg), var(--fg));
    background-repeat: no-repeat;
    background-size:
      100% 2px,
      68% 1px;
    background-position:
      left top,
      left 5px;
  }

  .window-title {
    flex: 1;
    color: var(--fg-subtle);
    font-family: var(--font-mono);
    font-size: 12px;
  }

  .window-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: var(--accent-soft-fg);
    font-size: 12.5px;
    font-weight: 600;
  }

  .window-link .i {
    width: 13px;
    height: 13px;
  }

  .window :global(pre) {
    margin: 0;
    padding: 16px 18px;
    max-height: 440px;
    overflow: auto;
    font-size: 12.5px;
    line-height: 1.7;
    background: transparent !important;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin-top: 28px;
    border-block: 1px solid var(--border);
    background: transparent;
  }

  .stats > * {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 22px 24px;
  }

  .stats > * + * {
    border-left: 1px solid var(--border);
  }

  .stats strong {
    font-family: var(--font-display);
    font-size: 34px;
    font-weight: 560;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
  }

  .stats span {
    color: var(--fg-subtle);
    font-size: 13.5px;
  }

  .values {
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: 56px;
  }

  .value {
    padding: 22px 0 28px;
    background-image:
      linear-gradient(var(--fg), var(--fg)),
      linear-gradient(var(--fg), var(--fg));
    background-repeat: no-repeat;
    background-size:
      28px 2px,
      18px 1px;
    background-position:
      left top,
      left 5px;
  }

  .value-index {
    display: block;
    margin-top: 12px;
    color: var(--clay);
    font-family: var(--font-display);
    font-style: italic;
    font-size: 18px;
  }

  .value h3 {
    margin-top: 6px;
    font-size: 20px;
  }

  .value p {
    margin-top: 8px;
    color: var(--fg-muted);
    font-size: 14px;
    line-height: 1.6;
  }

  .cats {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 250px), 1fr));
    gap: 14px;
  }

  .cat {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 18px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-elevated);
    transition: border-color 0.15s var(--ease), box-shadow 0.15s var(--ease);
  }

  .cat:hover {
    border-color: var(--fg);
    box-shadow: inset 3px 0 0 var(--clay);
  }

  .cat-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }

  .cat-head h3 {
    font-size: 15px;
  }

  .cat-head span {
    color: var(--fg-subtle);
    font-size: 13px;
    font-variant-numeric: tabular-nums;
  }

  .cat p {
    color: var(--fg-muted);
    font-size: 13.5px;
  }

  .cat-members {
    display: flex;
    gap: 4px;
    margin-top: 6px;
  }

  .logo-strip {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px 26px;
    margin-top: 40px;
    color: var(--fg-faint);
    font-family: var(--font-display);
    font-style: italic;
    font-size: 16px;
    font-weight: 500;
  }

  .fullstack .section-head {
    max-width: 720px;
  }

  .contract-note {
    margin-top: 14px;
    max-width: 760px;
    color: var(--fg-muted);
    font-size: 14px;
  }

  .contract td :global(code),
  .contract-note :global(code),
  .value p :global(code),
  .agents p :global(code) {
    padding: 1px 5px;
    border: 1px solid var(--border);
    border-radius: 5px;
    background: var(--bg-muted);
    font-size: 0.86em;
  }

  .agents p :global(a) {
    color: var(--accent-soft-fg);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .agents {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: center;
    padding: 36px 0 0;
    border: 0;
    border-radius: 0;
    background-color: transparent;
    background-image:
      linear-gradient(var(--fg), var(--fg)),
      linear-gradient(var(--fg), var(--fg));
    background-repeat: no-repeat;
    background-size:
      100% 2px,
      100% 1px;
    background-position:
      left top,
      left 4px;
  }

  .agents h2 {
    margin-top: 10px;
    font-size: clamp(24px, 3vw, 30px);
  }

  .agents p {
    margin-top: 14px;
    color: var(--fg-muted);
  }

  .agent-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 8px;
  }

  .agent-links a {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    padding: 12px 0;
    border: 0;
    border-bottom: 1px solid var(--border);
    border-radius: 0;
    background: transparent;
    transition: border-color 0.15s var(--ease);
  }

  .agent-links a:hover {
    border-color: var(--border-strong);
  }

  .agent-links .i {
    margin-top: 2px;
    color: var(--accent-soft-fg);
  }

  .agent-links strong {
    display: block;
    font-family: var(--font-mono);
    font-size: 13px;
  }

  .agent-links span span,
  .agent-links a > span {
    color: var(--fg-muted);
    font-size: 13.5px;
  }

  .cta-band {
    margin-top: 80px;
    padding: 72px 0 80px;
    background: var(--accent);
    color: var(--accent-fg);
  }

  .cta h2 {
    max-width: 18em;
    font-size: clamp(28px, 4vw, 44px);
    line-height: 1.05;
  }

  .cta-band .btn-primary {
    background: var(--accent-fg);
    color: var(--accent);
  }

  .cta-band .btn-primary:hover {
    background: var(--bg);
  }

  .cta-band .btn-secondary {
    background: transparent;
    color: var(--accent-fg);
    border-color: color-mix(in srgb, var(--accent-fg) 45%, transparent);
    box-shadow: none;
  }

  .cta-band .btn-secondary:hover {
    background: color-mix(in srgb, var(--accent-fg) 12%, transparent);
    border-color: var(--accent-fg);
  }

  @media (max-width: 960px) {
    .agents {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 640px) {
    .hero {
      padding-top: 40px;
    }
    .stats {
      grid-template-columns: 1fr 1fr;
    }
    .stats > :nth-child(3) {
      grid-column: 1 / -1;
      border-left: 0;
    }
    .stats > :nth-child(n + 3) {
      border-top: 1px solid var(--border);
    }
    .values {
      grid-template-columns: 1fr;
    }
    .agents {
      padding-top: 28px;
    }
  }
</style>
