---
import type { Service } from "../../lib/types.ts"

interface Props {
  service: Service
  size?: number
}
const { service, size = 48 } = Astro.props
---

<span class="vendor-logo" style={`--size:${size}px`}>
  <img src={service.brand.logo} alt="" width={size} height={size} loading="lazy" decoding="async" />
</span>

<style>
  /* Logos are drawn for white, so the tile stays white in both themes. */
  .vendor-logo {
    display: grid;
    place-items: center;
    flex: none;
    width: var(--size);
    height: var(--size);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: #fff;
  }

  .vendor-logo img {
    width: 58%;
    height: 58%;
    object-fit: contain;
  }
</style>
