---
/**
 * Landing figure: your app calls the same third-party services it always does, but each call
 * lands on that vendor's emulator inside your process. The real APIs sit outside the boundary,
 * never called. Every row is the same height so the connectors line up with the emulators.
 */
import catalog from "virtual:emulators/catalog"
import VendorLogo from "./VendorLogo.astro"

/** Service name → the host the real SDK would call. */
const SERVICES: [string, string][] = [
  ["stripe", "api.stripe.com"],
  ["twilio", "api.twilio.com"],
  ["openai", "api.openai.com"],
  ["slack", "slack.com/api"],
  ["resend", "api.resend.com"],
  ["s3", "s3.amazonaws.com"],
]
const ROW = 64
const height = SERVICES.length * ROW

const rows = SERVICES.map(([name, host], i) => {
  const service = catalog.services.find((s) => s.name === name)
  if (!service) throw new Error(`the landing figure names ${name}, which is not in the catalog`)
  const y = ROW / 2 + i * ROW
  return {
    service,
    host,
    path: `M0 ${height / 2} C 55 ${height / 2}, 45 ${y}, 100 ${y}`,
  }
})
---

<figure class="figure" aria-label="Your app calls Stripe, Twilio, OpenAI, Slack, Resend and S3. Each call reaches an emulator of that service inside your process; the real APIs are never called.">
  <div class="grid" style={`--rows:${rows.length};--row:${ROW}px`}>
    <div class="process">
      <span class="process-label">Your process</span>

      <div class="app">
        <span class="kicker">Your app</span>
        <strong>Unchanged code</strong>
        <span class="note">Same SDKs, same calls, base URL pointed at the emulator</span>
      </div>

      <svg class="wires" viewBox={`0 0 100 ${height}`} preserveAspectRatio="none" aria-hidden="true">
        {rows.map((r) => <path class="wire" d={r.path} />)}
      </svg>

      <ul class="emulates">
        {
          rows.map((r) => (
            <li>
              <VendorLogo service={r.service} size={42} />
              <span class="name">
                {r.service.brand.vendor}
                <small>emulator</small>
              </span>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="real">
      <span class="real-label">Real APIs · never called</span>
      <ul>
        {rows.map((r) => <li><code>{r.host}</code></li>)}
      </ul>
    </div>
  </div>

  <figcaption>
    <span><strong>0</strong> network calls</span>
    <span><strong>0</strong> sandbox keys</span>
    <span><strong>1</strong> call to reset state</span>
  </figcaption>
</figure>

<style>
  .figure {
    margin: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-elevated);
    overflow: hidden;
  }

  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: stretch;
    padding: 44px 40px 40px;
  }

  /* ---- your process ---- */

  .process {
    position: relative;
    display: grid;
    grid-template-columns: minmax(180px, 240px) minmax(80px, 320px) auto;
    justify-content: center;
    align-items: center;
    padding: 28px 28px 28px 24px;
    border: 1px solid var(--fg);
    border-radius: var(--radius);
    background: var(--bg);
  }

  .process-label,
  .real-label {
    position: absolute;
    top: -9px;
    padding: 0 8px;
    font-size: 11px;
    font-weight: 650;
    letter-spacing: 0.14em;
    line-height: 18px;
    text-transform: uppercase;
  }

  .process-label {
    left: 16px;
    background: var(--bg);
    color: var(--clay);
    box-shadow: 0 -9px 0 0 var(--bg-elevated);
  }

  .app {
    display: grid;
    gap: 4px;
    padding: 18px;
    border: 1px solid var(--fg);
    border-radius: var(--radius);
    background: var(--bg-elevated);
  }

  .kicker {
    color: var(--clay);
    font-size: 11px;
    font-weight: 650;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .app strong {
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 600;
  }

  .note {
    color: var(--fg-subtle);
    font-size: 13px;
    line-height: 1.45;
  }

  .wires {
    width: 100%;
    height: calc(var(--rows) * var(--row));
  }

  .wire {
    fill: none;
    stroke: var(--border-strong);
    stroke-width: 1.25;
    vector-effect: non-scaling-stroke;
  }

  .emulates,
  .real ul {
    display: grid;
    grid-auto-rows: var(--row);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .emulates li {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .name {
    display: grid;
    min-width: 7.5em;
    font-size: 14px;
    font-weight: 600;
    line-height: 1.25;
  }

  .name small {
    color: var(--clay);
    font-family: var(--font-display);
    font-style: italic;
    font-size: 13px;
    font-weight: 400;
  }

  /* ---- the real APIs, outside ---- */

  .real {
    position: relative;
    display: grid;
    align-content: center;
    padding: 28px 0;
  }

  .real-label {
    left: 14px;
    padding: 0;
    color: var(--fg-faint);
    white-space: nowrap;
  }

  .real li {
    display: flex;
    align-items: center;
  }

  /* A severed line: starts at the process wall and stops short of the host. */
  .real li::before {
    content: "";
    width: 36px;
    margin-right: 6px;
    border-top: 1px dashed var(--border-strong);
  }

  .real code {
    position: relative;
    padding-left: 16px;
    color: var(--fg-faint);
    font-family: var(--font-mono);
    font-size: 12.5px;
    text-decoration: line-through;
    text-decoration-color: color-mix(in srgb, var(--fg-faint) 70%, transparent);
  }

  .real code::before {
    content: "×";
    position: absolute;
    left: 0;
    color: var(--fg-faint);
    text-decoration: none;
  }

  figcaption {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--border);
  }

  figcaption span {
    padding: 16px 24px;
    color: var(--fg-subtle);
    font-size: 14px;
  }

  figcaption span + span {
    border-left: 1px solid var(--border);
  }

  figcaption strong {
    margin-right: 6px;
    color: var(--fg);
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 560;
  }

  @media (max-width: 960px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 36px;
      padding: 36px 24px 28px;
    }
    .real {
      padding: 0;
    }
    .real-label {
      position: static;
      padding: 0 0 10px;
    }
    .real ul {
      grid-template-columns: repeat(3, auto);
      grid-auto-rows: auto;
      justify-content: start;
      gap: 8px 24px;
    }
    .real li::before {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .process {
      grid-template-columns: minmax(0, 1fr);
      gap: 20px;
      padding: 28px 18px 18px;
    }
    .wires {
      display: none;
    }
    .emulates {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-auto-rows: auto;
      gap: 16px 12px;
    }
    .real ul {
      grid-template-columns: repeat(2, auto);
    }
    figcaption {
      grid-template-columns: 1fr;
    }
    figcaption span + span {
      border-top: 1px solid var(--border);
      border-left: 0;
    }
  }
</style>
