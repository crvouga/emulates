---
import ExampleView from "./ExampleView.astro"
import Icon from "./Icon.astro"

interface Props {
  /** Custom element that owns the loader lookup: `service-example` or `app-example`. */
  element: "service-example" | "app-example"
  /** Key the element resolves to a loader. */
  example: string
  title: string
  launchLabel?: string
  /** `app` fills the window edge to edge; `panel` insets a self-framed widget. */
  fit?: "app" | "panel"
}
const {
  element: Element,
  example,
  title,
  launchLabel = "Launch example",
  fit = "panel",
} = Astro.props
---

<Element data-example={example}>
  <div class="example-launch">
    <button type="button" class="btn btn-accent" data-example-open aria-haspopup="dialog">
      <Icon name="play" />
      {launchLabel}
    </button>
    <p>Opens fullscreen. The example runs in this tab.</p>
  </div>
  <ExampleView title={title} fit={fit} />
</Element>
