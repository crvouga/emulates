---
import { highlightSource } from "../../integrations/catalog/markdown.ts"
import { installCommand, PACKAGE_MANAGERS } from "../lib/format.ts"
import Icon from "./Icon.astro"

interface Props {
  pkg: string
}
const { pkg } = Astro.props
const commands = await Promise.all(
  PACKAGE_MANAGERS.map(async (pm) => ({
    pm,
    command: installCommand(pm, pkg),
    html: await highlightSource(installCommand(pm, pkg), "bash"),
  })),
)
---

<div class="pm">
  <div class="pm-tabs" role="tablist" aria-label="Package manager">
    {
      PACKAGE_MANAGERS.map((pm, i) => (
        <button type="button" role="tab" data-pm={pm} aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? 0 : -1}>
          {pm}
        </button>
      ))
    }
  </div>
  {
    commands.map(({ pm, command, html }, i) => (
      <div class="cmd" role="tabpanel" data-pm-panel={pm} hidden={i !== 0}>
        <span class="prompt">$</span>
        <Fragment set:html={html} />
        <button type="button" class="copy" data-copy={command} aria-label="Copy">
          <Icon name="copy" />
          <Icon name="check" />
        </button>
      </div>
    ))
  }
</div>
