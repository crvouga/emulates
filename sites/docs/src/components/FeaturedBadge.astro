---
import Icon from "./Icon.astro"
---

<span class="badge badge-featured" title="Featured emulator"><Icon name="star" /> Featured</span>

<style>
  .badge-featured { gap: 5px; color: var(--highlight); background: var(--accent-soft); border-color: color-mix(in srgb, var(--accent) 25%, var(--border)); flex: none; }
  .badge-featured :global(.i) { width: 12px; height: 12px; fill: currentColor; }
</style>
