---
import { IDENTITY } from "../lib/content.ts"

interface Props {
  size?: number
}
const { size = 34 } = Astro.props
---

<span class="bird-mark" style={`--mark-size: ${size}px`} aria-hidden="true">{IDENTITY.icon}</span>

<style>
  .bird-mark {
    display: inline-grid;
    place-items: center;
    vertical-align: middle;
    flex: none;
    width: var(--mark-size);
    height: var(--mark-size);
    font-family: "Apple Color Emoji", "Segoe UI Emoji", "Noto Color Emoji", sans-serif;
    font-size: var(--mark-size);
    font-weight: normal;
    line-height: 1;
  }
</style>
